---
// A Mondrian-style composition: each group is a colour panel sized by its posts.
// Click a panel and it takes over the composition, listing its posts as big rows;
// hovering a row floats that post's image beside the cursor.
import type { Article } from '../lib/sections';
import { dateLabel, excerpt } from '../lib/sections';
interface Group { id: string; name: string; colour: string; blurb: string; list: { a: Article; img: { src: string } }[] }
interface Props { groups: Group[] }
const { groups } = Astro.props;
// Panel grounds, in order; the composition reads left-to-right, top-to-bottom
const grounds = ['red', 'blue', 'yellow', 'ink', 'paper', 'paper-blue', 'red', 'yellow'];
---
<section class="comp-wrap">
  <div class="comp-bar">
    <p>Six corners of the subject. <b>Open one.</b></p>
    <button type="button" class="comp-die"><span class="die" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span> Surprise me</button>
  </div>
  <div class="comp" data-count={groups.length}>
    {groups.map((g, i) => (
      <article class={`panel panel--${grounds[i % grounds.length]} panel--${i}`} id={g.id} data-reveal="up" style={`--d:${i}`}>
        <button type="button" class="panel__close" aria-label={`Close ${g.name}`}>×</button>
        <button type="button" class="panel__open" aria-expanded="false" aria-controls={`${g.id}-list`}>
          <span class="panel__num">{String(i + 1).padStart(2, '0')}</span>
          <span class="panel__name">{g.name}</span>
          <span class="panel__count">{g.list.length} {g.list.length === 1 ? 'post' : 'posts'}</span>
          <span class="panel__tease" aria-hidden="true">{g.list.slice(0, 3).map((x) => <span>{x.a.data.title}</span>)}</span>
          <span class="panel__plus" aria-hidden="true">+</span>
        </button>
        <div class="panel__body" id={`${g.id}-list`} hidden>
          <p class="panel__blurb">{g.blurb}</p>
          <ol class="rows">
            {g.list.map(({ a, img }, k) => (
              <li style={`--k:${k}`}>
                <a href={`/${a.data.slug}/`} data-img={img.src || undefined}>
                  <span class="rows__n">{String(k + 1).padStart(2, '0')}</span>
                  <span class="rows__t">{a.data.title}</span>
                  <span class="rows__d">{dateLabel(a.data.pubDate)}</span>
                  <span class="rows__x">{excerpt(a, 150)}</span>
                </a>
              </li>
            ))}
          </ol>
          <img class="float" alt="" aria-hidden="true" />
        </div>
      </article>
    ))}
  </div>
</section>

<style is:global>
  .comp-wrap { max-width: 1500px; margin: 0 auto; padding: 3rem 16px 0; }
  .comp-bar { display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; margin-bottom: 1rem; }
  .comp-bar p { margin: 0; font-size: 1.2rem; }
  .comp-die { all: unset; cursor: pointer; display: inline-flex; align-items: center; gap: 0.7rem; padding: 0.6rem 1rem; background: var(--ink); color: var(--paper); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; }
  .comp-die:hover, .comp-die:focus-visible { background: var(--red); }
  .comp-die .die { position: relative; width: 26px; height: 26px; background: var(--yellow); border-radius: 4px; display: grid; grid-template-columns: repeat(3, 1fr); grid-template-rows: repeat(3, 1fr); padding: 3px; }
  .comp-die .die i { width: 5px; height: 5px; border-radius: 50%; background: var(--ink); place-self: center; }
  .comp-die .die i:nth-child(1) { grid-area: 1 / 1; } .comp-die .die i:nth-child(2) { grid-area: 1 / 3; } .comp-die .die i:nth-child(3) { grid-area: 2 / 2; } .comp-die .die i:nth-child(4) { grid-area: 3 / 1; } .comp-die .die i:nth-child(5) { grid-area: 3 / 3; }
  .comp-die.is-rolling .die { animation: roll .7s cubic-bezier(.3,.6,.3,1); }
  @keyframes roll { 50% { transform: rotate(400deg) scale(1.3); } 100% { transform: rotate(720deg); } }

  /* The composition: thick black lines between colour fields */
  .comp { position: relative; display: grid; grid-template-columns: repeat(12, 1fr); grid-template-rows: repeat(8, minmax(60px, 1fr)); gap: 12px; height: min(92vh, 860px); padding: 12px; background: var(--ink); }
  .panel--0 { grid-area: 1 / 1 / 6 / 8; }
  .panel--1 { grid-area: 1 / 8 / 4 / 13; }
  .panel--2 { grid-area: 4 / 8 / 9 / 11; }
  .panel--3 { grid-area: 4 / 11 / 9 / 13; }
  .panel--4 { grid-area: 6 / 1 / 9 / 4; }
  .panel--5 { grid-area: 6 / 4 / 9 / 8; }
  .panel--6, .panel--7 { grid-column: span 6; }
  .panel { position: relative; overflow: hidden; color: var(--paper); transition: transform .8s cubic-bezier(.2,.8,.2,1) calc(var(--d) * 80ms), opacity .6s calc(var(--d) * 80ms); }
  .panel:not(.in) { opacity: 0; transform: scale(.92); }
  .panel--red { background: var(--red); }
  .panel--blue { background: var(--blue); }
  .panel--yellow { background: var(--yellow); color: var(--ink); }
  .panel--ink { background: #222; }
  .panel--paper { background: var(--paper); color: var(--ink); }
  .panel--paper-blue { background: var(--paper-deep); color: var(--ink); }
  .panel--paper::before { content: ''; position: absolute; width: 70%; aspect-ratio: 1; border-radius: 50%; background: var(--red); right: -18%; bottom: -30%; transition: transform .7s cubic-bezier(.2,.9,.2,1.2); }
  .panel--paper-blue::before { content: ''; position: absolute; right: -10%; bottom: 0; width: 0; height: 0; border-left: 120px solid transparent; border-right: 120px solid transparent; border-bottom: 190px solid var(--blue); transition: transform .7s cubic-bezier(.2,.9,.2,1.2); }
  .panel:hover::before { transform: translate(-12%, -10%) scale(1.1); }

  .panel__open { all: unset; cursor: pointer; position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: flex-end; padding: clamp(14px, 2vw, 28px); box-sizing: border-box; }
  .panel__open:focus-visible { outline: 4px solid var(--paper); outline-offset: -8px; }
  .panel__num { position: absolute; top: clamp(14px, 2vw, 24px); left: clamp(14px, 2vw, 28px); font-weight: 800; font-size: 0.95rem; }
  .panel__plus { position: absolute; top: clamp(10px, 1.6vw, 20px); right: clamp(12px, 1.8vw, 24px); font-size: 2.4rem; font-weight: 300; line-height: 1; transition: transform .45s cubic-bezier(.2,.9,.2,1.4); }
  .panel:hover .panel__plus { transform: rotate(90deg) scale(1.2); }
  .panel__name { position: relative; font-weight: 800; letter-spacing: -0.045em; line-height: 0.9; text-transform: lowercase; font-size: clamp(1.6rem, 3.6vw, 4.6rem); transition: transform .5s cubic-bezier(.2,.9,.2,1.2); }
  .panel--0 .panel__name { font-size: clamp(2.4rem, 6.4vw, 7rem); }
  .panel--3 .panel__name, .panel--4 .panel__name { font-size: clamp(1.3rem, 2.4vw, 2.6rem); }
  .panel:hover .panel__name { transform: translateY(-8px); }
  .panel__count { position: relative; margin-top: 0.6rem; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; opacity: .85; }
  .panel__tease { position: absolute; top: 3.4rem; left: clamp(14px, 2vw, 28px); right: 3rem; display: grid; gap: 0.2rem; font-size: 0.88rem; font-weight: 500; opacity: 0; transform: translateY(-10px); transition: opacity .35s, transform .45s; }
  .panel__tease span { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .panel__tease span::before { content: '— '; }
  .panel:hover .panel__tease { opacity: .9; transform: none; }
  .panel--3 .panel__tease, .panel--4 .panel__tease { display: none; }

  /* Open: the panel takes over the composition */
  .comp.has-open .panel:not(.is-open) { filter: saturate(.3) brightness(.6); }
  .panel.is-open { grid-area: auto !important; position: absolute; inset: 12px; z-index: 10; overflow: auto; opacity: 1; transform: none; view-transition-name: open-panel; }
  .panel.is-open .panel__open { position: relative; inset: auto; padding-bottom: 0.4rem; cursor: default; pointer-events: none; }
  .panel.is-open .panel__plus, .panel.is-open .panel__tease { display: none; }
  .panel.is-open .panel__name { font-size: clamp(2.4rem, 6vw, 6rem); }
  .panel.is-open .panel__num { position: static; margin-bottom: 0.6rem; }
  .panel.is-open::before { opacity: .35; }
  .panel__body { position: relative; padding: 0 clamp(14px, 2vw, 28px) 2rem; }
  .panel__close { all: unset; display: none; cursor: pointer; z-index: 30; width: 56px; height: 56px; place-items: center; border-radius: 50%; background: var(--ink); color: var(--paper); font-size: 2rem; line-height: 1; }
  .panel.is-open .panel__close { display: grid; position: sticky; top: 16px; float: right; margin: 16px 16px 0 0; }
  .panel__close:hover, .panel__close:focus-visible { background: var(--paper); color: var(--ink); }
  .panel__blurb { margin: 0 0 1.6rem; max-width: 44ch; font-size: 1.15rem; }
  .rows { list-style: none; margin: 0; padding: 0; border-top: 4px solid currentColor; }
  .rows li { opacity: 0; transform: translateX(-30px); animation: rowin .55s cubic-bezier(.2,.9,.2,1) forwards; animation-delay: calc(var(--k) * 60ms + 150ms); }
  @keyframes rowin { to { opacity: 1; transform: none; } }
  .rows a { display: grid; grid-template-columns: 3.4rem 1fr auto; column-gap: 1rem; align-items: baseline; padding: 0.9rem 0; border-bottom: 2px solid currentColor; color: inherit; text-decoration: none; }
  .rows__n { font-weight: 800; }
  .rows__t { font-weight: 700; font-size: clamp(1.2rem, 2.4vw, 2rem); line-height: 1.05; letter-spacing: -0.02em; transition: transform .35s; }
  .rows__d { font-size: 0.68rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; white-space: nowrap; }
  .rows__x { grid-column: 2 / -1; max-height: 0; overflow: hidden; opacity: 0; font-size: 1rem; transition: max-height .45s, opacity .35s, margin .45s; }
  .rows a:hover .rows__t, .rows a:focus-visible .rows__t { transform: translateX(14px); }
  .rows a:hover .rows__x, .rows a:focus-visible .rows__x { max-height: 6em; opacity: .9; margin-top: 0.5rem; }
  .float { position: fixed; z-index: 40; left: 0; top: 0; width: 240px; aspect-ratio: 4 / 3; object-fit: cover; border: 6px solid var(--ink); box-shadow: 12px 12px 0 var(--yellow); pointer-events: none; opacity: 0; transform: translate(0, -50%) scale(.6) rotate(-6deg); transition: opacity .2s, transform .35s cubic-bezier(.2,.9,.2,1.3); }
  .float.is-on { opacity: 1; transform: translate(0, -50%) scale(1) rotate(-3deg); }
  .rows li.is-picked a { background: var(--paper); color: var(--ink); outline: 6px solid var(--paper); }

  @media (max-width: 900px) {
    .comp { display: flex; flex-direction: column; height: auto; }
    .panel { min-height: 34vh; }
    .panel--0 { min-height: 50vh; }
    .panel.is-open { position: fixed; inset: 0; z-index: 60; }
    .panel.is-open .panel__close { position: fixed; top: 14px; right: 14px; margin: 0; }
    .rows a { grid-template-columns: 2.4rem 1fr; }
    .rows__d { grid-column: 2; }
    .float { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .rows li { animation: none; opacity: 1; transform: none; } }
</style>

<script is:inline>
  (function () {
    var comp = document.querySelector('.comp'); if (!comp) return;
    var panels = [].slice.call(comp.querySelectorAll('.panel'));
    function morph(fn) { document.startViewTransition ? document.startViewTransition(fn) : fn(); }
    function open(p, then) {
      morph(function () {
        panels.forEach(function (x) { if (x !== p) close(x, true); });
        p.classList.add('is-open'); comp.classList.add('has-open');
        p.querySelector('.panel__open').setAttribute('aria-expanded', 'true');
        p.querySelector('.panel__body').hidden = false;
        p.scrollTop = 0;
      });
      comp.scrollIntoView({ behavior: 'smooth', block: 'start' });
      setTimeout(function () { var c = p.querySelector('.panel__close'); c && c.focus({ preventScroll: true }); then && then(); }, 420);
    }
    function close(p, quiet) {
      if (!p.classList.contains('is-open')) return;
      var go = function () {
        p.classList.remove('is-open'); comp.classList.remove('has-open');
        p.querySelector('.panel__open').setAttribute('aria-expanded', 'false');
        p.querySelector('.panel__body').hidden = true;
      };
      quiet ? go() : morph(go);
    }
    comp.addEventListener('click', function (e) {
      var o = e.target.closest('.panel__open'); if (o) open(o.closest('.panel'));
      var c = e.target.closest('.panel__close'); if (c) { var p = c.closest('.panel'); close(p); p.querySelector('.panel__open').focus({ preventScroll: true }); }
    });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') panels.forEach(function (p) { close(p); }); });
    if (location.hash) { var target = document.getElementById(location.hash.slice(1)); if (target && target.classList.contains('panel')) open(target); }

    // Image follows the cursor over a row
    panels.forEach(function (p) {
      var img = p.querySelector('.float');
      p.addEventListener('mouseover', function (e) { var a = e.target.closest('.rows a'); if (!a || !a.dataset.img) return; if (img.getAttribute('src') !== a.dataset.img) img.src = a.dataset.img; img.classList.add('is-on'); });
      p.addEventListener('mouseout', function (e) { if (e.target.closest('.rows a') && !(e.relatedTarget && e.relatedTarget.closest && e.relatedTarget.closest('.rows a'))) img.classList.remove('is-on'); });
      p.addEventListener('mousemove', function (e) { img.style.left = Math.min(e.clientX + 36, innerWidth - 270) + 'px'; img.style.top = e.clientY + 'px'; });
    });

    // Surprise me: open a random corner and point at one post in it
    var die = document.querySelector('.comp-die');
    die && die.addEventListener('click', function () {
      die.classList.remove('is-rolling'); void die.offsetWidth; die.classList.add('is-rolling');
      var p = panels[Math.floor(Math.random() * panels.length)];
      open(p, function () {
        var rows = p.querySelectorAll('.rows li'), r = rows[Math.floor(Math.random() * rows.length)];
        p.querySelectorAll('.is-picked').forEach(function (x) { x.classList.remove('is-picked'); });
        if (r) { r.classList.add('is-picked'); r.scrollIntoView({ behavior: 'smooth', block: 'center' }); }
      });
    });
  })();
</script>
