---
// Main-site shell. Bauhaus system: geometric sans, primary colours on paper,
// black bars, circles/squares/triangles, asymmetric grids.
import { SECTIONS } from '../lib/sections';
import Dial from '../components/Dial.astro';
interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: string;
  jsonLd?: object;
  bare?: boolean; // home page: no top bar, the page brings its own navigation
  noindex?: boolean; // pages search engines shouldn't list (e.g. the newsletter thank-you)
}
const {
  title,
  description = 'Better World With Design — reviews, music, photography and design by Gary Crossey.',
  image,
  type = 'website',
  jsonLd,
  bare = false,
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const path = Astro.url.pathname;
const siteGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': 'https://betterworldwithdesign.com/#site', name: 'Better World With Design', url: 'https://betterworldwithdesign.com/', inLanguage: 'en',
      publisher: { '@id': 'https://betterworldwithdesign.com/about/#gary' },
      potentialAction: { '@type': 'SearchAction', target: 'https://betterworldwithdesign.com/sitemap/?q={search_term_string}', 'query-input': 'required name=search_term_string' } },
    { '@type': 'Person', '@id': 'https://betterworldwithdesign.com/about/#gary', name: 'Gary Crossey', url: 'https://betterworldwithdesign.com/about/',
      jobTitle: 'Designer, web developer and SEO/AEO specialist',
      sameAs: ['https://photography.betterworldwithdesign.com/', 'https://podcast.betterworldwithdesign.com/', 'https://aeodecoded.ai/', 'https://www.instagram.com/betterworldwithdesign/', 'https://open.spotify.com/artist/1Pw2y2UrnP0Hhe9ZOszNYu'] },
  ],
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  <link rel="canonical" href={canonical} />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="theme-color" content="#2a2622" />
  <meta property="og:site_name" content="Better World With Design" />
  <meta property="og:type" content={type} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  {image && <meta property="og:image" content={image} />}
  <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
  <script type="application/ld+json" set:html={JSON.stringify(siteGraph)} />
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&family=Fraunces:wght@400;600&family=Source+Serif+4:wght@400;600&display=swap" rel="stylesheet" />
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-02EPG8KK2Y"></script>
  <script is:inline>
    (function(){
      var q = location.search;
      var d = '; domain=.betterworldwithdesign.com; path=/; SameSite=Lax';
      if (q.indexOf('notrack=1') > -1) document.cookie = 'bwwd_notrack=1; max-age=315360000' + d;
      if (q.indexOf('notrack=0') > -1) document.cookie = 'bwwd_notrack=; max-age=0' + d;
      if (document.cookie.indexOf('bwwd_notrack=1') > -1) window['ga-disable-G-02EPG8KK2Y'] = true;
    })();
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-02EPG8KK2Y');
  </script>
  <script is:inline>
    // Artwork linked from other sites: if it's blocked, try the post's next artwork; if none load, hide it
    document.addEventListener('error', function (e) {
      var el = e.target;
      if (el.tagName !== 'IMG' || !el.dataset.fallback) return;
      var rest = el.dataset.fallback === 'none' ? [] : el.dataset.fallback.split('|');
      var next = rest.shift();
      el.dataset.fallback = rest.length ? rest.join('|') : 'none';
      if (next) el.src = next;
      else { el.classList.add('is-missing'); var cap = el.parentNode && el.parentNode.querySelector('figcaption'); if (cap) cap.remove(); }
    }, true);
  </script>
  <style is:global>
    :root {
      --paper: #ece4d3;
      --paper-deep: #ddd2bd;
      --ink: #2a2622;
      --ink-soft: #5a534a;
      --red: #a9503d;
      --yellow: #c79d4f;
      --blue: #44596f;
      --brass: var(--red); /* links/accents */
      --rule: var(--ink);
      --font-display: 'Jost', 'Futura', 'Century Gothic', sans-serif;
      --font-body: 'Jost', 'Futura', 'Century Gothic', sans-serif;
      --wide: 1240px;
      --text: 680px;
    }
    *, *::before, *::after { box-sizing: border-box; }
    html { background: var(--paper); overflow-x: clip; }
    body { overflow-x: clip; }
    body {
      margin: 0;
      background: var(--paper);
      color: var(--ink);
      font-family: var(--font-body);
      font-size: 1.125rem;
      line-height: 1.7;
      -webkit-font-smoothing: antialiased;
    }
    img { max-width: 100%; height: auto; display: block; }
    a { color: var(--red); text-underline-offset: 4px; text-decoration-thickness: 2px; }
    a:hover { color: var(--blue); }
    h1, h2, h3, h4, h5 { font-family: var(--font-display); line-height: 1.05; font-weight: 700; letter-spacing: -0.015em; }
    img.is-missing { visibility: hidden; }
    ::selection { background: var(--yellow); color: var(--ink); }

    /* Masthead: black bar, geometric mark, uppercase nav */
    .masthead { background: var(--ink); color: var(--paper); position: relative; overflow: hidden; }
    .site-header {
      max-width: var(--wide); margin: 0 auto; padding: 1rem 16px;
      display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap;
      border-bottom: 1px solid #2b2b2b;
    }
    .brand { display: flex; align-items: center; gap: 0.7rem; color: var(--paper); text-decoration: none; font-weight: 700; font-size: 1.05rem; letter-spacing: 0.01em; text-transform: lowercase; }
    .brand:hover { color: var(--yellow); }
    .mark { display: inline-flex; align-items: flex-end; gap: 3px; height: 22px; }
    .mark i { display: block; }
    .mark .c { width: 20px; height: 20px; border-radius: 50%; background: var(--red); }
    .mark .s { width: 16px; height: 16px; background: var(--yellow); }
    .mark .t { width: 0; height: 0; border-left: 10px solid transparent; border-right: 10px solid transparent; border-bottom: 18px solid var(--blue); }
    .site-nav { display: flex; gap: 1.5rem; font-size: 0.8rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; flex-wrap: wrap; }
    .site-nav a { color: #cfc8bb; text-decoration: none; padding: 0.15rem 0; border-bottom: 3px solid transparent; }
    .site-nav a:hover { color: var(--paper); border-color: var(--yellow); }
    .site-nav a.is-section { color: var(--paper); border-color: var(--red); }

    .site-footer {
      max-width: var(--wide); margin: 6rem auto 0; padding: 1.6rem 16px 2.2rem;
      display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
      border-top: 8px solid var(--ink); font-size: 0.85rem; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase;
    }
    .site-footer a { color: var(--ink); text-decoration: none; border-bottom: 3px solid var(--red); }
    .site-footer a:hover { color: var(--blue); border-color: var(--blue); }

    /* Shared label: uppercase, tracked, on a colour block */
    .tag-block { display: inline-block; padding: 0.25rem 0.6rem; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; background: var(--red); color: var(--paper); text-decoration: none; }
    a.tag-block:hover { background: var(--yellow); color: var(--ink); }
  </style>
</head>
<body>
  <div class={bare ? 'masthead masthead--bare' : 'masthead'}>
    {!bare && <header class="site-header">
      <a class="brand" href="/"><span class="mark" aria-hidden="true"><i class="c"></i><i class="s"></i><i class="t"></i></span>better world with design</a>
      <nav class="site-nav" aria-label="Main">
        {SECTIONS.filter((s) => s.nav !== false).map((s) => (
          <a class={path.startsWith(`/category/${s.wpCat}/`) ? 'is-section' : undefined} href={`/category/${s.wpCat}/`}>{s.name}</a>
        ))}
        <a href="https://photography.betterworldwithdesign.com/">Photography</a>
        <a href="https://podcast.betterworldwithdesign.com/">Podcast</a>
      </nav>
    </header>}
    <slot name="masthead" />
  </div>
  <slot />
  <Dial />
  <footer class="site-footer">
    <span>© {new Date().getFullYear()} Gary Crossey · <a href="/about/">About</a> · <a href="/contact/">Contact</a> · <a href="/sitemap/">Index</a></span>
    <a href="https://podcast.betterworldwithdesign.com/">Listen to the podcast →</a>
  </footer>
  <script is:inline>
    // Reveal: anything marked [data-reveal] arrives when it scrolls into view and leaves when it goes
    (function () {
      if (window.__bwwdReveal) return; window.__bwwdReveal = true;
      var io = 'IntersectionObserver' in window && new IntersectionObserver(function (es) { es.forEach(function (e) { e.target.classList.toggle('in', e.isIntersecting); }); }, { threshold: 0.18 });
      document.querySelectorAll('[data-reveal]').forEach(function (el) { io ? io.observe(el) : el.classList.add('in'); });
    })();
  </script>
</body>
</html>
