---
// Section hub at the same URL WordPress used: /category/<wp-category>/
import Layout from '../../layouts/Layout.astro';
import { SECTIONS, getArticles, cardImage, dateLabel, absolute, type Section, type Article } from '../../lib/sections';

export async function getStaticPaths() {
  const articles = await getArticles();
  return SECTIONS.map((section) => ({
    params: { cat: section.wpCat },
    props: { section, items: articles.filter((a) => a.section.folder === section.folder) },
  }));
}

interface Props { section: Section; items: Article[] }
const { section, items } = Astro.props;
const cards = await Promise.all(items.map(async (a) => ({ a, img: await cardImage(a) })));
const square = section.look === 'sleeve';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: section.name,
  url: absolute(`/category/${section.wpCat}/`),
  hasPart: items.map((a) => ({ '@type': 'Article', headline: a.data.title, url: absolute(`/${a.data.slug}/`) })),
};
---
<Layout title={`${section.name} — Better World With Design`} description={section.blurb} jsonLd={jsonLd}>
  <header class="hub-head" slot="masthead">
    <span class="hub-shape hub-shape--circle" aria-hidden="true"></span>
    <span class="hub-shape hub-shape--tri" aria-hidden="true"></span>
    <div class="hub-head__inner">
      <p class="hub-count"><strong>{items.length}</strong> {items.length === 1 ? 'piece' : 'pieces'}</p>
      <h1>{section.name}</h1>
      <p class="hub-blurb">{section.blurb}</p>
    </div>
  </header>
  <main>
    <ul class={square ? 'cards cards--square' : 'cards'}>
      {cards.map(({ a, img }, i) => (
        <li class={i === 0 ? 'card card--lead' : 'card'}>
          <a href={`/${a.data.slug}/`}>
            {img.src
              ? <img src={img.src} alt={img.alt} loading={i < 4 ? 'eager' : 'lazy'} decoding="async" />
              : <span class="no-img" aria-hidden="true"><i></i></span>}
            <span class="date">{dateLabel(a.data.pubDate)}</span>
            <span class="title">{a.data.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </main>
</Layout>

<style>
  .hub-head { position: relative; overflow: hidden; color: var(--paper); }
  .hub-head__inner { position: relative; max-width: var(--wide); margin: 0 auto; padding: 3.2rem 16px 3.6rem; }
  .hub-head h1 { font-size: clamp(3rem, 10vw, 8rem); line-height: 0.9; letter-spacing: -0.04em; margin: 0.4rem 0 1rem; font-weight: 800; text-transform: lowercase; }
  .hub-count { margin: 0; font-size: 0.78rem; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: #cfc8bb; }
  .hub-count strong { display: inline-grid; place-items: center; min-width: 2.2rem; height: 2.2rem; padding: 0 0.4rem; margin-right: 0.4rem; background: var(--red); color: var(--paper); font-size: 1rem; letter-spacing: 0; }
  .hub-blurb { margin: 0; color: #cfc8bb; max-width: 44ch; font-size: 1.1rem; }
  .hub-shape { position: absolute; pointer-events: none; }
  .hub-shape--circle { width: 360px; height: 360px; border-radius: 50%; background: var(--yellow); right: 8%; top: 50%; transform: translateY(-50%); }
  .hub-shape--tri { right: -40px; bottom: 0; width: 0; height: 0; border-left: 170px solid transparent; border-right: 170px solid transparent; border-bottom: 260px solid var(--blue); }
  @media (max-width: 820px) {
    .hub-shape--circle { width: 180px; height: 180px; right: -50px; top: 30px; transform: none; }
    .hub-shape--tri { border-left-width: 80px; border-right-width: 80px; border-bottom-width: 120px; }
  }

  main { max-width: var(--wide); margin: 3.4rem auto 0; padding: 0 16px; }
  .cards { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 2.6rem 1.6rem; }
  .card a { display: block; text-decoration: none; color: var(--ink); }
  .card img, .no-img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; background: var(--paper-deep); display: block; border-top: 10px solid var(--ink); }
  .card:nth-child(3n+1) img { border-top-color: var(--red); }
  .card:nth-child(3n+2) img { border-top-color: var(--yellow); }
  .card:nth-child(3n) img { border-top-color: var(--blue); }
  .no-img { display: grid; place-items: center; }
  .no-img i { width: 40%; aspect-ratio: 1; border-radius: 50%; background: var(--red); }
  .cards--square .card img, .cards--square .no-img { aspect-ratio: 1; }
  .card--lead { grid-column: span 2; grid-row: span 2; }
  .card--lead img { aspect-ratio: auto; height: min(68vh, 620px); }
  .cards--square .card--lead img { aspect-ratio: 1; height: auto; }
  .card--lead .title { font-size: 2rem; }
  .date { display: block; margin-top: 0.8rem; font-size: 0.7rem; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink-soft); }
  .title { display: block; margin-top: 0.3rem; font-weight: 700; font-size: 1.15rem; line-height: 1.15; letter-spacing: -0.01em; }
  .card a:hover .title { color: var(--red); }
  @media (max-width: 980px) { .cards { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) {
    .cards { grid-template-columns: 1fr; }
    .card--lead { grid-column: auto; grid-row: auto; }
    .card--lead img { height: auto; aspect-ratio: 4 / 5; }
  }
</style>
