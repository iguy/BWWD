---
// Section hub at the same URL WordPress used: /category/<wp-category>/
import Layout from '../../layouts/Layout.astro';
import { SECTIONS, getArticles, cardImage, dateLabel, absolute, excerpt, type Section, type Article } from '../../lib/sections';
import Shelf from '../../components/Shelf.astro';
import Explore from '../../components/Explore.astro';
import ScrollThemes from '../../components/ScrollThemes.astro';
import SiteMap from '../../components/SiteMap.astro';
import techThemes from '../../data/tech-themes.json';
import musicThemes from '../../data/music-themes.json';
import shelfData from '../../data/book-shelves.json';

export async function getStaticPaths() {
  const articles = await getArticles();
  return SECTIONS.map((section) => ({
    params: { cat: section.wpCat },
    props: { section, items: articles.filter((a) => a.section.folder === section.folder) },
  }));
}

interface Props { section: Section; items: Article[] }
const { section, items } = Astro.props;
const cards = await Promise.all(items.map(async (a) => ({ a, img: await cardImage(a) })));
const square = section.look === 'sleeve';

// Books: grouped onto shelves (src/data/book-shelves.json); anything not listed lands on "More reviews"
const isBooks = section.folder === 'books';
const bySlug = new Map(cards.map((c) => [c.a.data.slug, c]));
const used = new Set<string>();
const shelves = isBooks
  ? shelfData.shelves.map((sh) => {
      const list = sh.books.map((b) => bySlug.get(b)).filter((x): x is (typeof cards)[number] => !!x);
      list.forEach((x) => used.add(x.a.data.slug));
      return { ...sh, list };
    }).concat([{ id: 'more', name: 'More reviews', colour: 'ink', blurb: '', books: [], list: cards.filter((c) => !used.has(c.a.data.slug)) }]).filter((sh) => sh.list.length)
  : [];
const pick = cards[0];

// Technology: themed groups to explore (src/data/tech-themes.json)
const THEMES: Record<string, typeof techThemes> = { technology: techThemes, music: musicThemes };
const themes = THEMES[section.folder];
const isTech = !!themes;
const techGroups = isTech
  ? (() => {
      const seen = new Set<string>();
      const gs = themes.groups.map((g) => {
        const list = g.posts.map((p) => bySlug.get(p)).filter((x): x is (typeof cards)[number] => !!x);
        list.forEach((x) => seen.add(x.a.data.slug));
        return { id: g.id, name: g.name, colour: g.colour, blurb: g.blurb, list };
      });
      const rest = cards.filter((c) => !seen.has(c.a.data.slug));
      return (rest.length ? gs.concat([{ id: 'more', name: 'More', colour: 'ink', blurb: '', list: rest }]) : gs).filter((g) => g.list.length);
    })()
  : [];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: section.name,
  url: absolute(`/category/${section.wpCat}/`),
  hasPart: items.map((a) => ({ '@type': 'Article', headline: a.data.title, url: absolute(`/${a.data.slug}/`) })),
};
---
<Layout title={`${section.name} — Better World With Design`} description={section.blurb} jsonLd={jsonLd}>
  <header class="hub-head" slot="masthead">
    <span class="hub-shape hub-shape--circle" aria-hidden="true"></span>
    <span class="hub-shape hub-shape--tri" aria-hidden="true"></span>
    <div class="hub-head__inner">
      <p class="hub-count"><strong>{items.length}</strong> {items.length === 1 ? 'piece' : 'pieces'}</p>
      <h1>{section.name}</h1>
      <p class="hub-blurb">{section.blurb}</p>
    </div>
  </header>
  {isTech ? (
  <Fragment>
  <main class="books">
    {pick && (
      <section class="latest" data-reveal="up">
        {pick.img.src && <img src={pick.img.src} alt="" loading="eager" decoding="async" />}
        <div>
          <p class="latest__label">{isBooks ? 'Newest on the shelf' : 'Newest'} · {dateLabel(pick.a.data.pubDate)}</p>
          <h2><a href={`/${pick.a.data.slug}/`}>{pick.a.data.title}</a></h2>
          <p>{excerpt(pick.a, 260)}</p>
          <a class="latest__go" href={`/${pick.a.data.slug}/`}>{isBooks ? 'Read the review →' : 'Read it →'}</a>
        </div>
      </section>
    )}
  </main>
  {section.folder === 'technology'
    ? <ScrollThemes groups={techGroups} />
    : <Explore groups={techGroups} total={cards.length} storageKey={section.folder} records={section.look === 'sleeve'} />}
  </Fragment>
  ) : isBooks ? (
  <main class="books">
    <nav class="shelf-index" aria-label="Shelves">
      {shelves.map((sh, i) => <a class={`chip chip--${sh.colour}`} href={`#${sh.id}`}><b>{String(i + 1).padStart(2, '0')}</b> {sh.name} <sup>{sh.list.length}</sup></a>)}
    </nav>
    {pick && (
      <section class="latest" data-reveal="up">
        {pick.img.src && <img src={pick.img.src} alt="" loading="eager" decoding="async" />}
        <div>
          <p class="latest__label">{isBooks ? 'Newest on the shelf' : 'Newest'} · {dateLabel(pick.a.data.pubDate)}</p>
          <h2><a href={`/${pick.a.data.slug}/`}>{pick.a.data.title}</a></h2>
          <p>{excerpt(pick.a, 260)}</p>
          <a class="latest__go" href={`/${pick.a.data.slug}/`}>{isBooks ? 'Read the review →' : 'Read it →'}</a>
        </div>
      </section>
    )}
    {shelves.map((sh, i) => (
      <section class={`bookshelf bookshelf--${sh.colour}${i % 2 ? ' alt' : ''}`} id={sh.id}>
        <div class="bookshelf__head" data-reveal="left">
          <span class="bookshelf__num">{String(i + 1).padStart(2, '0')}</span>
          <h2>{sh.name}</h2>
          {sh.blurb && <p>{sh.blurb}</p>}
          <p class="bookshelf__count">{sh.list.length} {sh.list.length === 1 ? 'book' : 'books'}</p>
        </div>
        <Shelf items={sh.list} height="min(56vh, 500px)" />
      </section>
    ))}
    <section class="books-end">
      <SiteMap title="the whole library" intro="Every shelf as a shape, sized by how many books it holds. Open one to see them all." groups={shelves.map((sh) => ({ id: `map-${sh.id}`, name: sh.name, href: `#${sh.id}`, colour: sh.colour, items: sh.list.map((x) => ({ t: x.a.data.title, h: `/${x.a.data.slug}/` })) }))} />
      <div class="books-next">
        <h2>keep reading</h2>
        <ul>
          <li class="books-next--blue"><a href="/montaigne-essays/"><span>Series</span>Montaigne, chapter by chapter<em>A 16th-century philosopher, read for now</em></a></li>
          <li class="books-next--red"><a href="/the-song-of-achilles-deep-dive-characters-relationships-and-modern-relevance/#quiz"><span>Quiz</span>Achilles, Patroclus or Hector?<em>Take Thetis's Prophecy</em></a></li>
          <li class="books-next--yellow"><a href="/media/books/the-song-of-achilles-deep-dive-characters-relationships-and-modern-relevance/beyond-the-battlefield-discussion-guide.pdf"><span>Book club</span>Beyond the Battlefield<em>Free discussion guide (PDF)</em></a></li>
          <li class="books-next--ink"><a href="https://podcast.betterworldwithdesign.com/"><span>Listen</span>The podcast<em>Book reviews you can hear</em></a></li>
        </ul>
        <p class="books-next__more"><a href="/sitemap/?q=book">Search every review →</a></p>
      </div>
    </section>
  </main>
  ) : (
  <main>
    <ul class={square ? 'cards cards--square' : 'cards'}>
      {cards.map(({ a, img }, i) => (
        <li class={i === 0 ? 'card card--lead' : 'card'}>
          <a href={`/${a.data.slug}/`}>
            {img.src
              ? <img src={img.src} data-fallback={img.fallback} alt={img.alt} loading={i < 4 ? 'eager' : 'lazy'} decoding="async" />
              : <span class="no-img" aria-hidden="true"><i></i></span>}
            <span class="date">{dateLabel(a.data.pubDate)}</span>
            <span class="title">{a.data.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </main>
  )}
</Layout>

<style is:global>
  .books-end { margin-top: 5rem; border-top: 10px solid var(--ink); }
  .books-next { max-width: 1100px; margin: 2rem auto 0; padding: 0 16px; }
  .books-next h2 { font-size: clamp(2.2rem, 5vw, 3.6rem); letter-spacing: -.04em; margin: 0 0 1rem; }
  .books-next ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 1rem; }
  .books-next a { display: grid; gap: .3rem; height: 100%; padding: 1.1rem; border: 3px solid var(--ink); background: var(--paper); color: var(--ink); text-decoration: none; font-weight: 800; font-size: 1.2rem; line-height: 1.15; transition: transform .25s cubic-bezier(.2,.9,.2,1.3); }
  .books-next a:hover { transform: translate(-4px, -4px) rotate(-1deg); }
  .books-next span { font-size: .68rem; letter-spacing: .2em; text-transform: uppercase; color: var(--ink-soft); }
  .books-next em { font-style: normal; font-weight: 500; font-size: .92rem; color: var(--ink-soft); }
  .books-next--red a { box-shadow: 8px 8px 0 var(--red); } .books-next--blue a { box-shadow: 8px 8px 0 var(--blue); } .books-next--yellow a { box-shadow: 8px 8px 0 var(--yellow); } .books-next--ink a { box-shadow: 8px 8px 0 var(--ink); }
  .books-next__more { margin-top: 1.6rem; font-weight: 700; }
</style>
<style is:global>
  /* Books page */
  .books { max-width: 1500px; margin: 0 auto; padding: 0 16px; }
  .shelf-index { position: sticky; top: 0; z-index: 20; display: flex; gap: 0.5rem; flex-wrap: wrap; padding: 1rem 0; background: var(--paper); border-bottom: 4px solid var(--ink); }
  .chip { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.45rem 0.8rem; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; text-decoration: none; color: var(--paper); background: var(--ink); }
  .chip b { font-weight: 800; }
  .chip sup { font-size: 0.6rem; }
  .chip--red { background: var(--red); } .chip--blue { background: var(--blue); } .chip--yellow { background: var(--yellow); color: var(--ink); }
  .chip:hover { transform: translateY(-2px); box-shadow: 4px 4px 0 var(--ink); }
  .latest { display: grid; grid-template-columns: 300px 1fr; gap: 2.5rem; align-items: center; margin: 4rem 0 2rem; padding: 2rem; border: 6px solid var(--ink); box-shadow: 14px 14px 0 var(--yellow); background: var(--paper); transition: transform .8s cubic-bezier(.2,.8,.2,1), opacity .6s; }
  .latest:not(.in) { opacity: 0; transform: translateY(60px); }
  .latest img { width: 100%; aspect-ratio: 3 / 4; object-fit: cover; border: 4px solid var(--ink); transform: rotate(-3deg); }
  .latest__label { margin: 0; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--red); }
  .latest h2 { margin: 0.7rem 0 1rem; font-size: clamp(1.8rem, 3.6vw, 3.2rem); line-height: 0.98; letter-spacing: -0.03em; }
  .latest h2 a { color: var(--ink); text-decoration: none; }
  .latest h2 a:hover { color: var(--red); }
  .latest p { max-width: 56ch; }
  .latest__go { display: inline-block; margin-top: 0.6rem; padding: 0.8rem 1.2rem; background: var(--ink); color: var(--paper); text-decoration: none; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; }
  .latest__go:hover { background: var(--red); color: var(--paper); }
  .bookshelf { display: grid; grid-template-columns: minmax(14rem, 0.42fr) 1.6fr; gap: 2.5rem; align-items: end; padding: 0 0 3rem; margin-top: -2rem; scroll-margin-top: 80px; }
  .bookshelf .shelf { padding-top: 220px; }
  .bookshelf.alt { grid-template-columns: 1.6fr minmax(14rem, 0.42fr); }
  .bookshelf.alt .bookshelf__head { order: 2; text-align: right; }
  .bookshelf.alt .bookshelf__head p { margin-left: auto; }
  .bookshelf__head { transition: transform .9s cubic-bezier(.2,.8,.2,1), opacity .7s; }
  .bookshelf__head:not(.in) { opacity: 0; transform: translateX(-10vw); }
  .bookshelf.alt .bookshelf__head:not(.in) { transform: translateX(10vw); }
  .bookshelf__num { display: inline-grid; place-items: center; width: 3rem; height: 3rem; font-weight: 800; color: var(--paper); background: var(--ink); }
  .bookshelf--red .bookshelf__num { background: var(--red); } .bookshelf--blue .bookshelf__num { background: var(--blue); } .bookshelf--yellow .bookshelf__num { background: var(--yellow); color: var(--ink); }
  .bookshelf__head h2 { margin: 0.8rem 0 0.7rem; font-size: clamp(2rem, 4.4vw, 3.6rem); line-height: 0.92; letter-spacing: -0.04em; font-weight: 800; text-transform: lowercase; }
  .bookshelf__head p { margin: 0 0 0.8rem; max-width: 30ch; }
  .bookshelf__count { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-soft); }
  @media (max-width: 900px) {
    .bookshelf, .bookshelf.alt { grid-template-columns: 1fr; }
    .bookshelf.alt .bookshelf__head { order: 0; text-align: left; }
    .latest { grid-template-columns: 1fr; }
    .latest img { max-width: 220px; }
  }
</style>

<style>
  .hub-head { position: relative; overflow: hidden; color: var(--paper); }
  .hub-head__inner { position: relative; max-width: var(--wide); margin: 0 auto; padding: 3.2rem 16px 3.6rem; }
  .hub-head h1 { font-size: clamp(3rem, 10vw, 8rem); line-height: 0.9; letter-spacing: -0.04em; margin: 0.4rem 0 1rem; font-weight: 800; text-transform: lowercase; }
  .hub-count { margin: 0; font-size: 0.78rem; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: #cfc8bb; }
  .hub-count strong { display: inline-grid; place-items: center; min-width: 2.2rem; height: 2.2rem; padding: 0 0.4rem; margin-right: 0.4rem; background: var(--red); color: var(--paper); font-size: 1rem; letter-spacing: 0; }
  .hub-blurb { margin: 0; color: #cfc8bb; max-width: 44ch; font-size: 1.1rem; }
  .hub-shape { position: absolute; pointer-events: none; }
  .hub-shape--circle { width: 360px; height: 360px; border-radius: 50%; background: var(--yellow); right: 8%; top: 50%; transform: translateY(-50%); }
  .hub-shape--tri { right: -40px; bottom: 0; width: 0; height: 0; border-left: 170px solid transparent; border-right: 170px solid transparent; border-bottom: 260px solid var(--blue); }
  @media (max-width: 820px) {
    .hub-shape--circle { width: 180px; height: 180px; right: -50px; top: 30px; transform: none; }
    .hub-shape--tri { border-left-width: 80px; border-right-width: 80px; border-bottom-width: 120px; }
  }

  main { max-width: var(--wide); margin: 3.4rem auto 0; padding: 0 16px; }
  .cards { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 2.6rem 1.6rem; }
  .card a { display: block; text-decoration: none; color: var(--ink); }
  .card img, .no-img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; background: var(--paper-deep); display: block; border-top: 10px solid var(--ink); }
  .card:nth-child(3n+1) img { border-top-color: var(--red); }
  .card:nth-child(3n+2) img { border-top-color: var(--yellow); }
  .card:nth-child(3n) img { border-top-color: var(--blue); }
  .no-img { display: grid; place-items: center; }
  .no-img i { width: 40%; aspect-ratio: 1; border-radius: 50%; background: var(--red); }
  .cards--square .card img, .cards--square .no-img { aspect-ratio: 1; }
  .card--lead { grid-column: span 2; grid-row: span 2; }
  .card--lead img { aspect-ratio: auto; height: min(68vh, 620px); }
  .cards--square .card--lead img { aspect-ratio: 1; height: auto; }
  .card--lead .title { font-size: 2rem; }
  .date { display: block; margin-top: 0.8rem; font-size: 0.7rem; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink-soft); }
  .title { display: block; margin-top: 0.3rem; font-weight: 700; font-size: 1.15rem; line-height: 1.15; letter-spacing: -0.01em; }
  .card a:hover .title { color: var(--red); }
  @media (max-width: 980px) { .cards { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) {
    .cards { grid-template-columns: 1fr; }
    .card--lead { grid-column: auto; grid-row: auto; }
    .card--lead img { height: auto; aspect-ratio: 4 / 5; }
  }
</style>
