---
// Home: a kinetic Bauhaus poster. Chapters arrive and leave as you scroll;
// navigation lives in a dial in the bottom-left corner.
import Layout from '../layouts/Layout.astro';
import podcast from '../data/podcast.json';
import featured from '../data/featured.json';
import Shelf from '../components/Shelf.astro';
import { SECTIONS, getArticles, cardImage, dateLabel, excerpt, paragraphs } from '../lib/sections';

const articles = await getArticles();
const bySection = (folder: string) => articles.filter((a) => a.section.folder === folder);
const withImg = async (items: typeof articles) => Promise.all(items.map(async (a) => ({ a, img: await cardImage(a) })));

const art = (await withImg(bySection('art-design'))).filter((x) => x.img.src).slice(0, 7);
const music = (await withImg(bySection('music'))).filter((x) => x.img.src).slice(0, 6);
const tech = (await withImg(bySection('technology'))).slice(0, 6).map((x) => ({ ...x, text: excerpt(x.a) }));
// Featured story: the newest Art & Design piece, told as a spread
const pinned = (featured.slug || '').trim();
const featArticle = (pinned && articles.find((a) => a.data.slug === pinned)) || articles[0]; // newest post on the site unless one is pinned
const feat = featArticle ? { a: featArticle, img: await cardImage(featArticle) } : undefined;
// A post with no image but a live piece (e.g. a Living Plates animation) shows the piece itself
const live = feat && !feat.img.src
  ? ((feat.a.body ?? '').match(/(?:<link[^>]*fonts\.googleapis[^>]*>\s*)?<style>[\s\S]*?<\/style>\s*<div[\s\S]*?<script>[\s\S]*?<\/script>/)?.[0] ?? '')
  : '';
const featText = feat ? excerpt(feat.a, 420) : '';
const featQuote = feat
  ? (paragraphs(feat.a).slice(3).join(' ').split(/(?<=[.!?])\s+(?=[A-Z"“])/) as string[])
      .map((t) => t.trim()).filter((t) => t.length >= 50 && t.length <= 220)
      .find((t) => /\$\d|\d{2,}|never|nobody|found|broke|vanish/i.test(t)) ?? ''
  : '';
// Books: every review as a spine on a shelf
const books = (await withImg(bySection('books'))).slice(0, 18);

// Podcast: latest episode leads, the next few follow
const POD = 'https://podcast.betterworldwithdesign.com';
const SPOTIFY_SHOW = 'https://open.spotify.com/show/4gzrOdC8LxmIBguCzoLjwM';
const [latest, ...recent] = podcast.episodes;
const moreEps = recent.slice(0, 6);
const small = SECTIONS.filter((s) => s.nav === false).map((s) => ({ s, n: bySection(s.folder).length }));

const PHOTO = 'https://photography.betterworldwithdesign.com';
const photos = [
  { src: `${PHOTO}/photography/asheville-pride/asheville-pride-5b88918f.jpg`, set: 'asheville-pride', alt: 'Marcher in a giant pink flower headdress, Asheville Pride' },
  { src: `${PHOTO}/photography/chicago-architecture/chicago-architecture-d6274776.jpg`, set: 'chicago-architecture', alt: "Marina City's scalloped balconies, Chicago" },
  { src: `${PHOTO}/photography/asheville-rugby-september-2026/asheville-rugby-09.jpg`, set: 'asheville-rugby-september-2026', alt: 'A hard tackle, Asheville Rugby' },
  { src: `${PHOTO}/photography/people/people-35e2cca1.jpg`, set: 'people', alt: 'Boy George on stage, London' },
  { src: `${PHOTO}/photography/chicago-architecture/chicago-architecture-0690b944.jpg`, set: 'chicago-architecture', alt: 'The Tiffany dome, Chicago Cultural Center' },
];


---
<Layout title="Better World With Design" bare>

  <a class="wordmark" href="/" aria-label="Better World With Design home"><i></i><i></i><i></i></a>

  <!-- 00 Poster -->
  <header class="poster" slot="masthead" data-scrub="top">
    <div class="poster__inner">
      <p class="kicker">Est. 2021 · Sandy Mush, North Carolina / Belfast</p>
      <h1><span>better</span> <span>world</span> <span>with</span> <span class="red">design</span></h1>
      <p class="poster__sub">Books, music, photography, art and technology — by Gary Crossey.</p>
    </div>
    <div class="poster__shapes" aria-hidden="true">
      <i class="p-circle"></i><i class="p-square"></i><i class="p-tri"></i><i class="p-bar"></i><i class="p-ring"></i>
    </div>
  </header>

  <main class="home">
    {feat && (
      <!-- Featured story: one piece, given room -->
      <section class="feature" id="featured" data-scrub="pass">
        <div class={live ? 'feature__art feature__art--live' : 'feature__art'} data-reveal="left">
          {live ? <div class="feature__live" set:html={live} /> : <img src={feat.img.src} data-fallback={feat.img.fallback} alt={feat.img.alt} loading="eager" decoding="async" />}
          <span class="feature__stamp">Featured</span>
        </div>
        <div class="feature__text" data-reveal="right">
          <p class="feature__meta"><span class="tag-block">{feat.a.section.name}</span> {dateLabel(feat.a.data.pubDate)}</p>
          <h2><a href={`/${feat.a.data.slug}/`}>{feat.a.data.title}</a></h2>
          {featQuote && <blockquote>{featQuote}</blockquote>}
          <p class="feature__lede">{featText}</p>
          <a class="feature__go" href={`/${feat.a.data.slug}/`}>Read the story <b>→</b></a>
        </div>
      </section>
    )}

    <!-- 01 Art: vertical slats that open on hover -->
    <section class="ch ch--art" id="art" data-scrub="pass">
      <div class="ch__word" aria-hidden="true">art</div>
      <div class="ch__head" data-reveal="left">
        <span class="ch__num">01</span>
        <h2>Art &amp; Design</h2>
        <p>Artists, photographers and movements I keep coming back to. Open a panel.</p>
        <a class="ch__all" href="/category/art-design-insights/">All art &amp; design →</a>
      </div>
      <ul class="slats">
        {art.map(({ a, img }, i) => (
          <li class="slat" data-reveal="up" style={`--d:${i}`}>
            <a href={`/${a.data.slug}/`}>
              <img src={img.src} data-fallback={img.fallback} alt={img.alt} loading="lazy" decoding="async" />
              <span class="slat__n">{String(i + 1).padStart(2, '0')}</span>
              <span class="slat__title">{a.data.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- 02 Books: a shelf of spines; pull one out -->
    <section class="ch ch--books" id="books">
      <div class="ch__head" data-reveal="left">
        <span class="ch__num">02</span>
        <h2>books</h2>
        <p>{bySection('books').length} reviews and reading lists. Pull one off the shelf.</p>
        <a class="ch__all" href="/category/book-reviews-reading-lists/">All books →</a>
      </div>
      <Shelf items={books} />
    </section>

    <!-- 03 Music: the record spins; sleeves fan out when the section arrives -->
    <section class="ch ch--music" id="music" data-scrub="pass">
      <div class="pin">
        <div class="vinyl" aria-hidden="true"><i></i></div>
        <div class="ch__head ch__head--light" data-reveal="right">
          <span class="ch__num">03</span>
          <h2>Music</h2>
          <p>Reviews, playlists and records — plus my own acid house as Warehouse Sunrise.</p>
          <a class="ch__all" href="/category/music-discovery-reviews/">All music →</a>
        </div>
        <ul class="fan" data-reveal="fan">
          {music.map(({ a, img }, i) => (
            <li class="sleeve-card" style={`--i:${i}; --n:${music.length}`}>
              <a href={`/${a.data.slug}/`}>
                <img src={img.src} alt={img.alt} loading="lazy" decoding="async" />
                <span>{a.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 04 Technology: rows that expand -->
    <section class="ch ch--tech" id="technology" data-scrub="pass">
      <div class="ch__word ch__word--right" aria-hidden="true">tech</div>
      <div class="ch__head" data-reveal="left">
        <span class="ch__num">04</span>
        <h2>Technology</h2>
        <p>AI tools, WordPress, search, and building a tech hub in Sandy Mush.</p>
        <a class="ch__all" href="/category/technology-trends-tips/">All technology →</a>
      </div>
      <ol class="rows">
        {tech.map(({ a, img, text }, i) => (
          <li class="row" data-reveal="right" style={`--d:${i}`}>
            <a href={`/${a.data.slug}/`}>
              <span class="row__n">{String(i + 1).padStart(2, '0')}</span>
              <span class="row__title">{a.data.title}</span>
              <span class="row__date">{dateLabel(a.data.pubDate)}</span>
              <span class="row__more">
                <span class="row__inner">
                  {img.src && <img src={img.src} alt="" loading="lazy" decoding="async" />}
                  <span class="row__text">{text}</span>
                </span>
              </span>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <!-- 05 Photography: dressed like the photography site (dark, serif, full colour), every photo opens its collection -->
    <section class="ch ch--photo" id="photography">
      <div class="ph">
        <div class="ph__grid" data-reveal="up">
          {photos.map((p, k) => <a class={`ph__m ph__m${k}`} href={`${PHOTO}/${p.set}/`}><img src={p.src} alt={p.alt} loading="lazy" decoding="async" /><span class="ph__cap">{p.alt}</span></a>)}
        </div>
        <div class="ph__text">
          <div>
            <p class="ph__label">05 · Photography · Gary Crossey</p>
            <h2>Pattern, structure, light, and people.</h2>
          </div>
          <div>
            <p>I photograph attention: the moment someone forgets the camera because they're locked onto something else. A ball in the air, a friend's face, a goat mid-leap. Mostly in the communities I belong to, around Asheville, North Carolina.</p>
            <div class="ph__btns">
              <a class="ph__btn ph__btn--solid" href={PHOTO + '/#work'}>See the work</a>
              <a class="ph__btn" href={PHOTO + '/book/'}>Book a session</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 06 Podcast: latest episode inside the rings, recent episodes alongside -->
    <section class="ch ch--pod" id="podcast">
      <div class="pod__text" data-reveal="left">
        <span class="ch__num">06</span>
        <h2>podcast</h2>
        <p class="pod__latest-label">Latest · Episode {latest.n} · {latest.mins} min</p>
        <h3 class="pod__title"><a href={`${POD}/podcast/${latest.slug}/`}>{latest.title}</a></h3>
        <p class="pod__summary">{latest.summary.replace(/\s+\S*$/, '')}…</p>
        <div class="pod__actions">
          <button class="pod__play" type="button" data-audio={latest.audio} aria-label={`Play episode ${latest.n}`}><span></span>Play</button>
          <a class="ch__all" href={`${POD}/podcast/${latest.slug}/`}>Episode + transcript ↗</a>
          <a class="ch__all" href={SPOTIFY_SHOW}>Spotify ↗</a>
        </div>
      </div>
      <a class="pod__rings" href={`${POD}/podcast/${latest.slug}/`} aria-label={`Episode ${latest.n}: ${latest.title}`} data-reveal="right">
        <span class="rings" aria-hidden="true"><i></i><i></i><i></i><i></i><i><img src={latest.image} alt="" loading="lazy" decoding="async" /></i></span>
      </a>
      <ol class="eps" data-reveal="up">
        {moreEps.map((e, k) => (
          <li style={`--d:${k}`}>
            <a href={`${POD}/podcast/${e.slug}/`}>
              <img src={e.image} alt="" loading="lazy" decoding="async" />
              <span class="eps__n">Ep {e.n} · {e.mins} min</span>
              <span class="eps__t">{e.title}</span>
            </a>
          </li>
        ))}
        <li class="eps__all"><a href={`${POD}/`}><span>All {podcast.episodes.length} episodes →</span></a></li>
      </ol>
    </section>

    <!-- Archive: everything else, as a moving band -->
    <section class="ch ch--archive" id="archive">
      <p class="big-count" data-reveal="up"><strong data-total={articles.length}>{articles.length}</strong> essays, reviews, playlists and experiments — and more arriving from the old site.</p>
      <div class="marquee" aria-label="More sections">
        <div class="marquee__track">
          {[0, 1].map((k) => (
            <span class="marquee__set" aria-hidden={k === 1 ? 'true' : undefined}>
              {small.map(({ s, n }) => (
                <a href={`/category/${s.wpCat}/`} data-n={n} tabindex={k === 1 ? -1 : undefined}>{s.name} <sup>{n}</sup></a>
              ))}
              <a href="/category/book-reviews-reading-lists/" data-n={bySection('books').length} tabindex={k === 1 ? -1 : undefined}>Books <sup>{bySection('books').length}</sup></a>
              <a href="/category/art-design-insights/" data-n={bySection('art-design').length} tabindex={k === 1 ? -1 : undefined}>Art &amp; Design <sup>{bySection('art-design').length}</sup></a>
              <a href="/category/music-discovery-reviews/" data-n={bySection('music').length} tabindex={k === 1 ? -1 : undefined}>Music <sup>{bySection('music').length}</sup></a>
              <a href="/category/technology-trends-tips/" data-n={bySection('technology').length} tabindex={k === 1 ? -1 : undefined}>Technology <sup>{bySection('technology').length}</sup></a>
            </span>
          ))}
        </div>
      </div>
    </section>
  </main>

  <script is:inline>
    (function () {
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var root = document.documentElement;

      // Panels arrive when they enter the screen and leave again when they go
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { e.target.classList.toggle('in', e.isIntersecting); });
      }, { threshold: 0.18 });
      document.querySelectorAll('[data-reveal]').forEach(function (el) { reduce ? el.classList.add('in') : io.observe(el); });

      // Scroll progress per chapter (--p from 0 to 1) and for the page (--page)
      var scrubs = [].slice.call(document.querySelectorAll('[data-scrub]'));
      var ticking = false;
      function update() {
        ticking = false;
        var vh = window.innerHeight;
        scrubs.forEach(function (el) {
          var r = el.getBoundingClientRect(), p;
          if (el.dataset.scrub === 'pin') p = -r.top / Math.max(1, r.height - vh);
          else if (el.dataset.scrub === 'top') p = -r.top / Math.max(1, r.height);
          else p = (vh - r.top) / (r.height + vh);
          el.style.setProperty('--p', Math.min(1, Math.max(0, p)).toFixed(4));
        });
        var max = document.documentElement.scrollHeight - vh;
        root.style.setProperty('--page', (max > 0 ? window.scrollY / max : 0).toFixed(4));
      }
      if (!reduce) {
        window.addEventListener('scroll', function () { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
        window.addEventListener('resize', update);
      }
      update();

      // Podcast: play the latest episode right here
      var playBtn = document.querySelector('.pod__play'), audio;
      if (playBtn) playBtn.addEventListener('click', function () {
        if (!audio) { audio = new Audio(playBtn.dataset.audio); audio.addEventListener('ended', function () { playBtn.classList.remove('is-playing'); }); }
        if (audio.paused) { audio.play(); playBtn.classList.add('is-playing'); playBtn.lastChild.textContent = 'Pause'; document.querySelector('.ch--pod').classList.add('is-playing'); }
        else { audio.pause(); playBtn.classList.remove('is-playing'); playBtn.lastChild.textContent = 'Play'; document.querySelector('.ch--pod').classList.remove('is-playing'); }
      });

      // Big number: shows the hovered topic's count in that topic's colour, back to the total on leave
      var big = document.querySelector('.big-count strong');
      if (big) {
        var tones = ['var(--ink)', 'var(--yellow)', 'var(--blue)']; // red hover -> ink, yellow -> yellow, blue -> blue
        function show(n, tone) {
          if (big.textContent === String(n)) return;
          big.classList.remove('is-swap'); void big.offsetWidth; big.classList.add('is-swap');
          big.textContent = n; big.style.color = tone || '';
        }
        document.querySelectorAll('.marquee a[data-n]').forEach(function (a) {
          var i = [].indexOf.call(a.parentNode.children, a);
          var on = function () { show(a.dataset.n, tones[i % 3]); };
          a.addEventListener('pointerenter', on); a.addEventListener('focus', on);
        });
        var reset = function () { show(big.dataset.total); };
        document.querySelector('.marquee').addEventListener('pointerleave', reset);
        document.querySelector('.marquee').addEventListener('focusout', reset);
      }

      // Topic band: drifts on its own; the mouse steers it (left edge = left, right edge = right), and it can be dragged or swiped
      var band = document.querySelector('.marquee'), track = band && band.querySelector('.marquee__track');
      if (band && track) {
        var x = 0, base = reduce ? -0.25 : -0.6, speed = base, target = base, half = 0, drag = null, last = 0;
        function measure() { half = track.scrollWidth / 2; }
        measure(); window.addEventListener('resize', measure);
        var press = null, dragged = false;
        band.addEventListener('pointermove', function (e) {
          if (press && !drag && Math.abs(e.clientX - press.x) > 6) { drag = { x: e.clientX, v: 0 }; dragged = true; band.classList.add('is-dragging'); band.setPointerCapture(e.pointerId); }
          if (drag) { var dx = e.clientX - drag.x; drag.x = e.clientX; x += dx; drag.v = dx; return; }
          var r = band.getBoundingClientRect(), f = (e.clientX - r.left) / r.width - 0.5; // -0.5 .. 0.5
          target = base - f * 18; // always drifting; towards an edge it speeds up in that direction
        });
        band.addEventListener('pointerleave', function () { if (!drag) target = base; });
        band.addEventListener('dragstart', function (e) { e.preventDefault(); }); // links would otherwise start a native drag
        band.addEventListener('pointerdown', function (e) { press = { x: e.clientX }; dragged = false; });
        function endDrag() { press = null; if (!drag) return; speed = drag.v; drag = null; band.classList.remove('is-dragging'); }
        band.addEventListener('pointerup', endDrag); band.addEventListener('pointercancel', endDrag);
        // A plain click follows the link; a drag doesn't
        band.addEventListener('click', function (e) { if (dragged) { e.preventDefault(); dragged = false; } }, true);
        band.addEventListener('wheel', function (e) { if (Math.abs(e.deltaX) > Math.abs(e.deltaY)) { x -= e.deltaX; e.preventDefault(); } }, { passive: false });
        function tick(t) {
          if (!drag) { speed += (target - speed) * 0.06; x += speed; }
          if (half) { while (x <= -half) x += half; while (x > 0) x -= half; }
          track.style.transform = 'translateX(' + x + 'px)';
          requestAnimationFrame(tick);
        }
        requestAnimationFrame(tick);
      }

    })();
  </script>
</Layout>

<style is:global>
  html { scroll-behavior: smooth; }
  .masthead--bare { background: var(--ink); }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .site-footer { padding-left: max(16px, 120px); }

  /* ---------- Wordmark (top-left, just shapes) ---------- */
  .wordmark { position: fixed; z-index: 40; top: 18px; left: 18px; display: flex; align-items: flex-end; gap: 4px; padding: 8px; background: var(--paper); }
  .wordmark i:nth-child(1) { width: 18px; height: 18px; border-radius: 50%; background: var(--red); }
  .wordmark i:nth-child(2) { width: 15px; height: 15px; background: var(--yellow); }
  .wordmark i:nth-child(3) { width: 0; height: 0; border-left: 9px solid transparent; border-right: 9px solid transparent; border-bottom: 16px solid var(--blue); }


  /* ---------- Poster ---------- */
  .poster { position: relative; overflow: hidden; color: var(--paper); min-height: 540px; }
  .poster__inner { position: relative; z-index: 2; width: 100%; max-width: var(--wide); margin: 0 auto; padding: 4.5rem 16px 4.5rem max(16px, 110px); }
  .kicker { margin: 0 0 1.4rem; font-size: 0.74rem; font-weight: 600; letter-spacing: 0.22em; text-transform: uppercase; color: #a9a294; }
  .poster h1 { margin: 0; font-size: clamp(3.2rem, 11vw, 9.5rem); line-height: 0.84; font-weight: 800; letter-spacing: -0.055em; max-width: 7ch; }
  .poster h1 span { display: block; transform: translateX(calc(var(--p, 0) * var(--x, 0) * 1px)); }
  .poster h1 span:nth-child(1) { --x: -160; } .poster h1 span:nth-child(2) { --x: 120; } .poster h1 span:nth-child(3) { --x: -60; } .poster h1 span:nth-child(4) { --x: 220; }
  .poster h1 .red { color: var(--red); }
  .poster__sub { margin: 1.8rem 0 0; max-width: 32ch; color: #cfc8bb; font-size: 1.2rem; }
  .poster__cue { margin: 3rem 0 0; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.24em; text-transform: uppercase; color: var(--yellow); }
  .poster__cue b { display: inline-block; animation: bob 1.6s ease-in-out infinite; }
  @keyframes bob { 50% { transform: translateY(6px); } }
  .poster__shapes i { position: absolute; display: block; will-change: transform; }
  .p-circle { width: 440px; aspect-ratio: 1; border-radius: 50%; background: var(--yellow); right: 6%; top: 40px; transform: translateY(calc(var(--p, 0) * 160px)) scale(calc(1 + var(--p, 0) * .25)); }
  .p-square { width: 210px; aspect-ratio: 1; background: var(--blue); right: 30%; bottom: 0; transform: rotate(calc(var(--p, 0) * 60deg)) translateY(calc(var(--p, 0) * -120px)); }
  .p-tri { right: 4vw; bottom: 0; width: 0; height: 0; border-left: 130px solid transparent; border-right: 130px solid transparent; border-bottom: 220px solid var(--red); transform: translateX(calc(var(--p, 0) * 200px)); }
  .p-bar { left: 0; bottom: 0; width: 24%; height: 18px; background: var(--paper); transform: scaleX(calc(1 + var(--p, 0) * 3)); transform-origin: left; }
  .p-ring { width: 110px; height: 110px; border-radius: 50%; border: 12px solid var(--paper); left: 52%; top: 50px; transform: translateY(calc(var(--p, 0) * -200px)); }
  @media (max-width: 820px) {
    .poster__inner { padding-left: 16px; padding-top: 7rem; }
    .poster { min-height: 0; }
    .p-circle { width: 200px; right: -60px; top: 20px; }
    .p-square { width: 90px; right: 22%; }
    .p-tri { border-left-width: 60px; border-right-width: 60px; border-bottom-width: 100px; }
    .p-ring { display: none; }
  }

  /* ---------- Chapters ---------- */
  .home { overflow-x: clip; }
  .ch { position: relative; }
  .ch__head { position: relative; z-index: 2; max-width: 30rem; }
  .ch__num { display: inline-grid; place-items: center; width: 3rem; height: 3rem; background: var(--red); color: var(--paper); font-weight: 800; font-size: 1rem; }
  .ch__head h2 { margin: 1rem 0 0.8rem; font-size: clamp(3rem, 8vw, 6.5rem); line-height: 0.88; letter-spacing: -0.045em; font-weight: 800; text-transform: lowercase; }
  .ch__head p { margin: 0 0 1.4rem; font-size: 1.15rem; max-width: 30ch; }
  .ch__all { display: inline-block; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; text-decoration: none; color: inherit; border-bottom: 4px solid var(--red); padding-bottom: 0.2rem; }
  .ch__all:hover { color: var(--red); }
  .ch__head--light .ch__all { border-color: var(--yellow); }
  .ch__head--light .ch__all:hover { color: var(--yellow); }
  .ch__word {
    position: absolute; z-index: 0; pointer-events: none; font-weight: 800; letter-spacing: -0.06em; line-height: 0.75;
