---
// Home for the new main site. Lists the sections that have moved so far.
import Layout from '../layouts/Layout.astro';
import { SECTIONS, getArticles, mediaUrl, dateLabel } from '../lib/sections';
const articles = await getArticles();
---
<Layout title="Better World With Design">
  <header class="home-head" slot="masthead">
    <h1>Better World With Design</h1>
    <p>Books, music, photography, art and technology, by Gary Crossey.</p>
  </header>
  <main>
    {SECTIONS.map((s) => {
      const items = articles.filter((a) => a.section.folder === s.folder).slice(0, 6);
      return (
        <section>
          <h2><a href={`/category/${s.wpCat}/`}>{s.name}</a></h2>
          <ul>
            {items.map((a) => (
              <li>
                <a href={`/${a.data.slug}/`}>
                  {a.data.cover && <img src={mediaUrl(a.data.cover, a.section)} alt={a.data.coverAlt} loading="lazy" decoding="async" />}
                  <span class="date">{dateLabel(a.data.pubDate)}</span>
                  <span class="title">{a.data.title}</span>
                </a>
              </li>
            ))}
          </ul>
          <a class="all" href={`/category/${s.wpCat}/`}>All of {s.name} →</a>
        </section>
      );
    })}
  </main>
</Layout>

<style>
  .home-head { max-width: var(--wide); margin: 0 auto; padding: 2.75rem 16px 3rem; }
  .home-head h1 { font-size: clamp(2.2rem, 6vw, 3.6rem); margin: 0 0 0.6rem; color: #efe6d6; }
  .home-head p { margin: 0; color: #b9ae98; }
  main { max-width: var(--wide); margin: 3rem auto 0; padding: 0 16px; }
  h2 a { color: var(--ink); text-decoration: none; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 2rem 1.8rem; }
  li a { display: block; text-decoration: none; color: var(--ink); }
  img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .date { display: block; font-size: 0.85rem; color: var(--ink-soft); margin-top: 0.8rem; }
  .title { display: block; font-family: var(--font-display); font-weight: 600; font-size: 1.15rem; line-height: 1.25; margin-top: 0.2rem; }
  .all { display: inline-block; margin-top: 2rem; }
</style>
