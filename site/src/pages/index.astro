---
// Home for the new main site: a Bauhaus poster, then each section.
import Layout from '../layouts/Layout.astro';
import { SECTIONS, getArticles, cardImage, dateLabel } from '../lib/sections';
const articles = await getArticles();
const rows = await Promise.all(
  SECTIONS.filter((s) => s.nav !== false).map(async (s) => {
    const items = articles.filter((a) => a.section.folder === s.folder).slice(0, 4);
    return { s, items: await Promise.all(items.map(async (a) => ({ a, img: await cardImage(a) }))) };
  }),
);
---
<Layout title="Better World With Design">
  <header class="poster" slot="masthead">
    <div class="poster__inner">
      <h1><span>better</span> <span>world</span> <span>with</span> <span class="red">design</span></h1>
      <p>Books, music, photography, art and technology — by Gary Crossey.</p>
    </div>
    <div class="poster__shapes" aria-hidden="true">
      <i class="p-circle"></i><i class="p-square"></i><i class="p-tri"></i><i class="p-bar"></i>
    </div>
  </header>
  <main>
    {rows.map(({ s, items }, n) => (
      <section class="row">
        <div class="row__head">
          <span class={`row__num row__num--${n % 3}`}>{String(n + 1).padStart(2, '0')}</span>
          <h2><a href={`/category/${s.wpCat}/`}>{s.name}</a></h2>
          <a class="row__all" href={`/category/${s.wpCat}/`}>All →</a>
        </div>
        <ul>
          {items.map(({ a, img }) => (
            <li>
              <a href={`/${a.data.slug}/`}>
                {img.src && <img src={img.src} data-fallback={img.fallback} alt={img.alt} loading="lazy" decoding="async" />}
                <span class="date">{dateLabel(a.data.pubDate)}</span>
                <span class="title">{a.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </main>
</Layout>

<style>
  .poster { position: relative; overflow: hidden; color: var(--paper); min-height: 520px; }
  .poster__inner { position: relative; z-index: 1; max-width: var(--wide); margin: 0 auto; padding: 4rem 16px 4.5rem; }
  .poster h1 { margin: 0; font-size: clamp(3.2rem, 11vw, 9.5rem); line-height: 0.86; font-weight: 800; letter-spacing: -0.05em; max-width: 7ch; }
  .poster h1 span { display: block; }
  .poster h1 .red { color: var(--red); }
  .poster p { margin: 1.6rem 0 0; max-width: 34ch; color: #cfc8bb; font-size: 1.15rem; }
  .poster__shapes { position: absolute; inset: 0; pointer-events: none; }
  .poster__shapes i { position: absolute; display: block; }
  .p-circle { width: 440px; height: 440px; border-radius: 50%; background: var(--yellow); right: 6%; top: 40px; }
  .p-square { width: 210px; height: 210px; background: var(--blue); right: 30%; bottom: 0; }
  .p-tri { right: 2%; bottom: 0; width: 0; height: 0; border-left: 130px solid transparent; border-right: 130px solid transparent; border-bottom: 220px solid var(--red); }
  .p-bar { left: 0; bottom: 0; width: 22%; height: 16px; background: var(--paper); }
  @media (max-width: 820px) {
    .poster { min-height: 0; }
    .p-circle { width: 200px; height: 200px; right: -60px; top: 20px; }
    .p-square { width: 90px; height: 90px; right: 22%; }
    .p-tri { border-left-width: 60px; border-right-width: 60px; border-bottom-width: 100px; }
  }

  main { max-width: var(--wide); margin: 3.6rem auto 0; padding: 0 16px; }
  .row { margin-bottom: 4.5rem; }
  .row__head { display: flex; align-items: center; gap: 1rem; border-bottom: 10px solid var(--ink); padding-bottom: 0.8rem; margin-bottom: 1.8rem; }
  .row__num { display: grid; place-items: center; width: 3rem; height: 3rem; font-weight: 800; background: var(--red); color: var(--paper); }
  .row__num--1 { background: var(--yellow); color: var(--ink); }
  .row__num--2 { background: var(--blue); }
  .row h2 { margin: 0; font-size: clamp(1.8rem, 4vw, 2.8rem); text-transform: lowercase; letter-spacing: -0.03em; flex: 1; }
  .row h2 a { color: var(--ink); text-decoration: none; }
  .row h2 a:hover { color: var(--red); }
  .row__all { font-size: 0.78rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; text-decoration: none; color: var(--ink); }
  ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.6rem; }
  li a { display: block; text-decoration: none; color: var(--ink); }
  img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; background: var(--paper-deep); }
  .date { display: block; margin-top: 0.8rem; font-size: 0.7rem; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink-soft); }
  .title { display: block; margin-top: 0.3rem; font-weight: 700; font-size: 1.1rem; line-height: 1.15; }
  li a:hover .title { color: var(--red); }
  @media (max-width: 980px) { ul { grid-template-columns: repeat(2, 1fr); } }
</style>
