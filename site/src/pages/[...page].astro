---
// Standalone pages moved from WordPress (About, Contact, …), at their original URLs.
// Content: ../migration/pages/<slug>.md
import Layout from '../layouts/Layout.astro';
import Shelf from '../components/Shelf.astro';
import { getCollection } from 'astro:content';
import { getArticles, cardImage, mediaUrl, absolute, type Section } from '../lib/sections';
import { cleanHtml } from '../lib/clean';
import '../styles/article.css';
import montaigneData from '../data/montaigne.json';
import metaDescriptions from '../data/meta.json';
import { paragraphs, excerpt } from '../lib/sections';

function chapterOf(t: string) { const m = t.match(/chapter\s*(\d+)/i); return m ? +m[1] : 99; }
const PAGES: Section = { folder: 'pages', name: 'Pages', wpCat: '', blurb: '' };

export async function getStaticPaths() {
  const all = await getCollection('articles');
  return all
    .filter((e) => (e.filePath ?? '').includes('/pages/'))
    .map((entry) => ({ params: { page: entry.data.oldPath.replace(/^\/|\/$/g, '') }, props: { entry } }));
}

const { entry } = Astro.props;
const { title, description, slug } = entry.data;
const html = cleanHtml(entry.body ?? '', PAGES, { title, keepForms: true, lede: true });
const cover = entry.data.cover ? absolute(mediaUrl(entry.data.cover, PAGES)) : undefined;

// Montaigne Essays: the essays themselves, as a shelf
const meta = (metaDescriptions as Record<string, string>)[slug] || description || undefined;
const pageUrl = absolute(entry.data.oldPath || `/${slug}/`);
const pageType = slug === 'about' ? 'AboutPage' : slug === 'contact' ? 'ContactPage' : slug === 'montaigne-essays' ? 'CollectionPage' : 'WebPage';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': pageType,
  '@id': pageUrl,
  name: title,
  description: meta,
  url: pageUrl,
  image: cover,
  inLanguage: 'en',
  isPartOf: { '@id': absolute('/') + '#site' },
  ...(slug === 'about' ? { mainEntity: { '@id': absolute('/about/') + '#gary' } } : {}),
};
const isThanks = slug === 'thank-you-newsletter';
const PICKS = ['the-song-of-achilles-deep-dive-characters-relationships-and-modern-relevance', 'the-answer-engine-far-but-near', 'chapter-23-various-events-form-the-same-counsel'];
const picks = isThanks ? (await getArticles()).filter((a) => PICKS.includes(a.data.slug)).sort((a, b) => PICKS.indexOf(a.data.slug) - PICKS.indexOf(b.data.slug)) : [];
const isMontaigne = slug === 'montaigne-essays';
const montaigne = isMontaigne
  ? await Promise.all((await getArticles()).filter((a) => a.data.tags.includes('Montaigne') || /montaigne/i.test(a.data.title))
      .sort((a, b) => chapterOf(a.data.title) - chapterOf(b.data.title))
      .map(async (a) => ({ a, img: await cardImage(a) })))
  : [];
// Montaigne intro: the page's own words, before the old slider
const intro = isMontaigne ? (entry.body ?? '').split('et_pb_slider')[0] : '';
const introBlocks = [...intro.matchAll(/<(h3|p)[^>]*>([\s\S]*?)<\/\1>/gi)]
  .map((m) => ({ tag: m[1], text: m[2].replace(/<[^>]+>/g, '').replace(/&#8217;|&rsquo;/g, '’').replace(/&#8220;|&#8221;|&quot;/g, '"').replace(/&amp;/g, '&').trim() }))
  .filter((b) => b.text);
const graphic = isMontaigne ? '/media/pages/montaigne-essays/montaigne-two-faces.png' : '';
const quotes = montaigneData.quotes as Record<string, { q: string; mark: string }>;
const markUp = (q: string, mark: string) => q.replace(mark, `<mark>${mark}</mark>`);
const subjectOf = (t: string) => t.replace(/^Montaigne\s*[–-]\s*chapter\s*\d+\s*[–—-]+\s*/i, '').replace(/^Chapter\s*\d+\s*[–-]\s*/i, '').replace(/\s*\(&?\s*Podcast\)/i, '').replace(/\b([A-Z]{2,})\b/g, (w) => w[0] + w.slice(1).toLowerCase());
---
<Layout title={`${title} — Better World With Design`} description={meta} image={cover} jsonLd={isThanks ? undefined : jsonLd} noindex={isThanks}>
  {!isThanks && <header class="hero hero--plain" slot="masthead">
    <span class="shape shape--sun" aria-hidden="true"></span>
    <span class="shape shape--bar" aria-hidden="true"></span>
    <div class="hero__inner">
      <div class="hero__text">
        <a class="tag-block" href="/">Better World With Design</a>
        <h1>{title}</h1>
      </div>
    </div>
  </header>}
  {isThanks ? (
  <main class="thanks">
    <div class="thanks__mark" aria-hidden="true"><i class="c"></i><i class="s"></i><i class="t"></i></div>
    <p class="thanks__kicker">Newsletter</p>
    <h1>You're in.</h1>
    <p class="thanks__lede">No autoresponder sequence, no welcome funnel. Just the next dispatch when there's something worth sending: music, photography, books, and the occasional argument about design.</p>
    <p class="thanks__check">Check your inbox: Mailchimp may ask you to confirm your address.</p>
    <h2>While you're here</h2>
    <ul class="thanks__picks">
      {picks.map((a, i) => <li class={`thanks__pick thanks__pick--${['red', 'blue', 'yellow'][i]}`}><a href={`/${a.data.slug}/`}><span>{a.section.name}</span>{a.data.title}</a></li>)}
    </ul>
    <p class="thanks__more"><a href="/">Back to the homepage</a> · <a href="/sitemap/">Browse everything</a> · <a href="https://podcast.betterworldwithdesign.com/">Listen to the podcast</a></p>
  </main>
  ) : isMontaigne ? (
  <main class="mtg">
    <!-- Smoke: wisps in the palette, drifting slowly behind the page (taken from the two-faces graphic) -->
    <div class="smoke" aria-hidden="true">
      {[
        { c: '#a9503d', o: 0.17, d: 'M-200 260 C 150 120, 380 420, 700 300 S 1150 80, 1500 240 M-150 560 C 200 420, 420 720, 760 600 S 1100 420, 1350 560', cls: 'smoke__l smoke__l--red' },
        { c: '#c79d4f', o: 0.15, d: 'M-100 760 C 260 640, 520 900, 820 780 S 1300 620, 1700 760 M300 120 C 520 40, 700 220, 980 140', cls: 'smoke__l smoke__l--yellow' },
        { c: '#44596f', o: 0.14, d: 'M700 900 C 900 760, 1100 980, 1350 820 S 1600 700, 1800 820 M900 360 C 1100 220, 1300 460, 1650 300 M1000 620 C 1200 520, 1400 700, 1750 560', cls: 'smoke__l smoke__l--blue' },
      ].map((l, i) => (
        <div class={l.cls}>
          <svg viewBox="0 0 1600 1000" preserveAspectRatio="xMidYMid slice">
            <defs>
              <filter id={`smoke-f${i}`} x="-30%" y="-30%" width="160%" height="160%">
                <feTurbulence type="fractalNoise" baseFrequency="0.003 0.011" numOctaves="3" seed={7 + i * 13} result="n" />
                <feGaussianBlur in="SourceGraphic" stdDeviation="5" result="b" />
                <feDisplacementMap in="b" in2="n" scale="140" xChannelSelector="R" yChannelSelector="G" />
              </filter>
            </defs>
            <g filter={`url(#smoke-f${i})`} fill="none" stroke={l.c} stroke-linecap="round" opacity={l.o}>
              <path d={l.d} stroke-width="12" transform="translate(30 -36)" />
              <path d={l.d} stroke-width="5" transform="translate(-48 28)" />
              <path d={l.d} stroke-width="2.5" transform="translate(70 60)" />
              <path d={l.d} stroke-width="1.5" transform="translate(-90 -70)" />
            </g>
          </svg>
        </div>
      ))}
    </div>
    <script is:inline>
      // Smoke follows you: layers shift with the mouse and scroll at different depths; the cursor leaves faint puffs
      (function () {
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var smoke = document.querySelector('.smoke'), main = document.querySelector('.mtg');
        if (!smoke || !main) return;
        var colours = ['#a9503d', '#c79d4f', '#44596f'], last = 0, alive = 0;
        addEventListener('pointermove', function (e) {
          smoke.style.setProperty('--mx', (e.clientX / innerWidth - 0.5).toFixed(3));
          smoke.style.setProperty('--my', (e.clientY / innerHeight - 0.5).toFixed(3));
          var now = performance.now();
          if (e.pointerType !== 'mouse' || now - last < 70 || alive > 24) return;
          var r = main.getBoundingClientRect(); if (e.clientY < r.top) return;
          last = now; alive++;
          var p = document.createElement('span'); p.className = 'puff';
          p.style.left = e.clientX + 'px'; p.style.top = e.clientY + 'px';
          p.style.setProperty('--c', colours[Math.floor(Math.random() * 3)]);
          p.style.setProperty('--r', (50 + Math.random() * 70) + 'px');
          p.style.setProperty('--dx', (Math.random() * 80 - 40) + 'px');
          main.appendChild(p);
          p.addEventListener('animationend', function () { p.remove(); alive--; });
        }, { passive: true });
        var ticking = false;
        addEventListener('scroll', function () { if (ticking) return; ticking = true; requestAnimationFrame(function () { smoke.style.setProperty('--sy', scrollY.toFixed(0)); ticking = false; }); }, { passive: true });
      })();
    </script>
    <section class="mtg-hero">
      <img class="mtg-hero__art" src={graphic} alt="Two profiles facing each other: Montaigne and a modern reader" />
      <div class="mtg-hero__text" data-reveal="right">
        <p class="mtg-kicker">The Montaigne Project</p>
        <p class="mtg-big">Essays through a <span>modern</span> lens.</p>
        <p class="mtg-lede">{introBlocks[0]?.text}</p>
      </div>
    </section>

    <section class="page-shelf">
      <p class="page-shelf__label">{montaigne.length} essays — pull one off the shelf</p>
      <Shelf items={montaigne} colours={['blue', 'red', 'yellow', 'ink']} height="min(56vh, 500px)" />
    </section>

    <section class="mtg-intro">
      {(() => {
        const cols: { h: string; ps: string[] }[] = [];
        introBlocks.slice(1).forEach((b) => { if (b.tag === 'h3') cols.push({ h: b.text, ps: [] }); else if (cols.length) cols[cols.length - 1].ps.push(b.text); });
        return cols.map((c, i) => (
          <div class="mtg-col" data-reveal={i ? 'right' : 'left'}>
            <h2>{c.h}</h2>
            {c.ps.map((t) => <p>{t}</p>)}
          </div>
        ));
      })()}
    </section>

    <ol class="mtg-essays">
      {montaigne.map(({ a }, i) => {
        const ch = chapterOf(a.data.title);
        const qt = quotes[a.data.slug];
        return (
          <li class={`mtg-essay mtg-essay--${['blue', 'red', 'yellow', 'ink'][i % 4]}${i % 2 ? ' alt' : ''}`}>
            <span class="mtg-ch" aria-hidden="true">{ch < 99 ? ch : ''}</span>
            <div class="mtg-essay__text" data-reveal={i % 2 ? 'right' : 'left'}>
              <p class="mtg-essay__label">Book I · Chapter {ch}</p>
              <h3><a href={`/${a.data.slug}/`}>{subjectOf(a.data.title)}</a></h3>
              {qt && <blockquote class="mtg-quote" set:html={markUp(qt.q, qt.mark)} />}
              <a class="mtg-go" href={`/${a.data.slug}/`}>Read the essay →</a>
            </div>
          </li>
        );
      })}
    </ol>
  </main>
  ) : (
  <main>
    {montaigne.length > 0 && (
      <section class="page-shelf">
        <p class="page-shelf__label">{montaigne.length} essays — pull one off the shelf</p>
        <Shelf items={montaigne} colours={['blue', 'red', 'yellow', 'ink']} height="min(56vh, 500px)" />
      </section>
    )}
    <article class="article article--page" set:html={html} />
  </main>
  )}
</Layout>

<style is:global>
  /* Montaigne Essays */
  .thanks { max-width: 760px; margin: 0 auto; padding: 4rem 16px 2rem; }
  .thanks__mark { display: flex; gap: 10px; align-items: flex-end; margin-bottom: 1.6rem; }
  .thanks__mark i { display: block; animation: thanks-pop .7s cubic-bezier(.2,.9,.2,1.4) both; }
  .thanks__mark .c { width: 54px; height: 54px; border-radius: 50%; background: var(--red); }
  .thanks__mark .s { width: 44px; height: 44px; background: var(--yellow); animation-delay: .12s; }
  .thanks__mark .t { width: 0; height: 0; border-left: 26px solid transparent; border-right: 26px solid transparent; border-bottom: 46px solid var(--blue); animation-delay: .24s; }
  @keyframes thanks-pop { from { transform: translateY(30px) scale(.4); opacity: 0; } to { transform: none; opacity: 1; } }
  .thanks__kicker { margin: 0; font-size: .74rem; font-weight: 700; letter-spacing: .22em; text-transform: uppercase; color: var(--red); }
  .thanks h1 { margin: .3rem 0 1rem; font-size: clamp(3.4rem, 10vw, 6.5rem); line-height: .9; letter-spacing: -.05em; font-weight: 800; }
  .thanks__lede { font-size: 1.3rem; line-height: 1.45; margin: 0 0 1rem; }
  .thanks__check { display: inline-block; margin: 0 0 3rem; padding: .5rem .8rem; background: var(--paper-deep); font-size: .95rem; }
  .thanks h2 { font-size: 1.6rem; margin: 0 0 1rem; border-top: 6px solid var(--ink); padding-top: .8rem; }
  .thanks__picks { list-style: none; margin: 0; padding: 0; display: grid; gap: .8rem; }
  .thanks__pick a { display: grid; gap: .2rem; padding: 1rem 1.1rem; border: 3px solid var(--ink); background: var(--paper); color: var(--ink); text-decoration: none; font-weight: 700; font-size: 1.15rem; transition: transform .25s, box-shadow .25s; }
  .thanks__pick span { font-size: .7rem; letter-spacing: .18em; text-transform: uppercase; color: var(--ink-soft); }
  .thanks__pick--red a { box-shadow: 7px 7px 0 var(--red); } .thanks__pick--blue a { box-shadow: 7px 7px 0 var(--blue); } .thanks__pick--yellow a { box-shadow: 7px 7px 0 var(--yellow); }
  .thanks__pick a:hover { transform: translate(-3px, -3px); }
  .thanks__more { margin-top: 2rem; font-weight: 600; }
  .mtg { overflow-x: clip; position: relative; isolation: isolate; clip-path: inset(0); }
  .smoke { position: fixed; inset: 0; z-index: -1; pointer-events: none; overflow: hidden; }
  .smoke__l { position: absolute; inset: -12%; will-change: transform, translate; transition: translate 1.2s cubic-bezier(.2,.8,.2,1); translate: calc(var(--mx, 0) * var(--depth) * -1px) calc(var(--my, 0) * var(--depth) * -1px + var(--sy, 0) * var(--depth) * -0.0025px); }
  .smoke__l--red { --depth: 60; } .smoke__l--yellow { --depth: 35; } .smoke__l--blue { --depth: 85; }
  .puff { position: fixed; z-index: -1; width: var(--r); height: var(--r); margin: calc(var(--r) / -2) 0 0 calc(var(--r) / -2); border-radius: 50%; pointer-events: none; background: radial-gradient(circle, var(--c) 0%, transparent 68%); opacity: 0; filter: blur(6px); animation: puff 2.6s ease-out forwards; }
  @keyframes puff { 0% { opacity: .32; transform: translate(0, 0) scale(.4); } 100% { opacity: 0; transform: translate(var(--dx), -90px) scale(2.4) rotate(40deg); } }
  .smoke__l svg { width: 100%; height: 100%; display: block; }
  .smoke__l--red { animation: smoke-a 22s ease-in-out infinite alternate; }
  .smoke__l--yellow { animation: smoke-b 28s ease-in-out infinite alternate; }
  .smoke__l--blue { animation: smoke-c 25s ease-in-out infinite alternate; }
  @keyframes smoke-a { from { transform: translate(-4%, 2%) rotate(-2deg) scale(1); } to { transform: translate(5%, -4%) rotate(3deg) scale(1.08); } }
  @keyframes smoke-b { from { transform: translate(3%, 4%) rotate(1deg); } to { transform: translate(-5%, -2%) rotate(-3deg) scale(1.06); } }
  @keyframes smoke-c { from { transform: translate(4%, -3%) scale(1.04); } to { transform: translate(-4%, 4%) rotate(2deg) scale(1); } }
  @media (prefers-reduced-motion: reduce) { .smoke__l { animation: none; transition: none; translate: none; } .puff { display: none; } }
  .mtg-hero { position: relative; display: grid; grid-template-columns: 1.15fr 1fr; align-items: center; gap: 3rem; max-width: 1400px; margin: 0 auto; padding: 4rem 16px 2rem; }
  .mtg-hero__art { width: 100%; height: auto; mix-blend-mode: multiply; }
  .mtg-kicker { margin: 0; font-size: 0.74rem; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; color: var(--red); }
  .mtg-big { margin: 0.6rem 0 1.4rem; font-size: clamp(2.6rem, 6vw, 5.6rem); line-height: 1.02; font-weight: 800; letter-spacing: -0.045em; }
  .mtg-big span { color: var(--paper); background: var(--blue); padding: 0 0.12em; box-decoration-break: clone; }
  .mtg-lede { margin: 0; font-size: 1.3rem; line-height: 1.45; max-width: 30ch; }
  .mtg-intro { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; max-width: 1100px; margin: 5rem auto 0; padding: 0 16px; }
  .mtg-col h2 { margin: 0 0 1rem; font-size: 2.2rem; letter-spacing: -0.03em; border-top: 10px solid var(--ink); padding-top: 1rem; }
  .mtg-col p { margin: 0 0 1rem; }
  [data-reveal].mtg-col { transition: transform .9s cubic-bezier(.2,.8,.2,1), opacity .7s; }
  .mtg-col:not(.in) { opacity: 0; transform: translateY(40px); }

  .mtg-essays { list-style: none; margin: 6rem 0 0; padding: 0; }
  .mtg-essay { position: relative; min-height: 78vh; display: grid; align-items: center; padding: 4rem 16px; border-top: 4px solid var(--ink); overflow: hidden; }
  .mtg-ch { position: absolute; z-index: 0; right: -2vw; top: 50%; transform: translateY(-50%); font-weight: 800; line-height: 0.75; letter-spacing: -0.08em; font-size: clamp(14rem, 42vw, 40rem); color: color-mix(in srgb, var(--ink) 9%, transparent); -webkit-text-stroke: 3px var(--ink); opacity: .9; pointer-events: none; transition: color 1.2s; }
  .mtg-essay.alt .mtg-ch { right: auto; left: -2vw; }
  .mtg-essay--blue .mtg-ch { -webkit-text-stroke-color: var(--blue); color: color-mix(in srgb, var(--blue) 16%, transparent); }
  .mtg-essay--red .mtg-ch { -webkit-text-stroke-color: var(--red); color: color-mix(in srgb, var(--red) 16%, transparent); }
  .mtg-essay--yellow .mtg-ch { -webkit-text-stroke-color: var(--yellow); -webkit-text-stroke-width: 5px; color: color-mix(in srgb, var(--yellow) 22%, transparent); }
  .mtg-essay__text { position: relative; z-index: 1; max-width: 760px; margin: 0 auto 0 max(16px, 6vw); transition: transform 1s cubic-bezier(.2,.8,.2,1), opacity .8s; }
  .mtg-essay.alt .mtg-essay__text { margin: 0 max(16px, 6vw) 0 auto; text-align: right; }
  .mtg-essay__text:not(.in) { opacity: 0; transform: translateX(-10vw); }
  .mtg-essay.alt .mtg-essay__text:not(.in) { transform: translateX(10vw); }
  .mtg-essay__label { margin: 0; font-size: 0.74rem; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; color: var(--ink-soft); }
  .mtg-essay h3 { margin: 0.6rem 0 1.6rem; font-size: clamp(2rem, 4.6vw, 4rem); line-height: 0.95; letter-spacing: -0.04em; font-weight: 800; }
  .mtg-essay h3 a { color: var(--ink); text-decoration: none; }
  .mtg-essay h3 a:hover { color: var(--red); }
  .mtg-quote { margin: 0 0 2rem; font-size: clamp(1.5rem, 3vw, 2.6rem); line-height: 1.18; font-weight: 500; letter-spacing: -0.02em; }
  .mtg-quote::before { content: '“'; display: block; font-size: 5rem; line-height: 0.6; font-weight: 800; color: var(--red); }
  .mtg-essay.alt .mtg-quote::before { margin-left: auto; width: fit-content; }
  .mtg-quote mark { color: inherit; background: linear-gradient(var(--yellow), var(--yellow)) no-repeat 0 85% / 0% 0.42em; transition: background-size 1.1s cubic-bezier(.7,0,.2,1) .5s; padding: 0 0.05em; }
  .mtg-essay--yellow .mtg-quote mark { background-image: linear-gradient(var(--blue), var(--blue)); color: inherit; }
  .mtg-essay__text.in .mtg-quote mark { background-size: 100% 0.42em; }
  .mtg-go { display: inline-block; padding: 0.9rem 1.3rem; background: var(--ink); color: var(--paper); text-decoration: none; font-size: 0.8rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; }
  .mtg-go:hover { background: var(--red); color: var(--paper); }
  @media (max-width: 900px) {
    .mtg-hero, .mtg-intro { grid-template-columns: 1fr; }
    .mtg-essay { min-height: 0; padding: 5rem 16px; }
    .mtg-essay.alt .mtg-essay__text { text-align: left; margin: 0; }
    .mtg-essay__text { margin: 0; }
    .mtg-ch { font-size: 60vw; opacity: .35; }
  }

  .page-shelf { max-width: 1240px; margin: 1rem auto 0; }
  .page-shelf__label { margin: 3rem 0 -1rem; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; }
  .article--page form { margin: 2rem 0; padding: 1.4rem; border: 4px solid var(--ink); background: var(--paper-deep); }
  .article--page input[type="email"], .article--page input[type="text"] { width: 100%; padding: 0.7rem 0.8rem; font: inherit; border: 2px solid var(--ink); background: var(--paper); margin: 0.3rem 0 1rem; }
  .article--page input[type="submit"], .article--page button { padding: 0.8rem 1.3rem; border: 0; background: var(--red); color: var(--paper); font: inherit; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; cursor: pointer; }
  .article--page input[type="submit"]:hover, .article--page button:hover { background: var(--ink); }
  .article--page .wp-block-latest-posts { list-style: none; padding: 0; border-top: 6px solid var(--ink); }
  .article--page .wp-block-latest-posts li { padding: 0.7rem 0; border-bottom: 2px solid var(--ink); font-weight: 600; }
</style>
