---
// Every article keeps its WordPress URL: /<slug>/
import Layout from '../layouts/Layout.astro';
import { getArticles, mediaUrl, absolute, dateLabel, type Article } from '../lib/sections';
import { cleanHtml, takeArt } from '../lib/clean';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article) => {
    const inSection = articles.filter((a) => a.section.folder === article.section.folder);
    const i = inSection.findIndex((a) => a.id === article.id);
    return {
      params: { slug: decodeURIComponent(article.data.slug) }, // emoji slugs: file path matches the decoded URL
      props: { article, newer: inSection[i - 1], older: inSection[i + 1] },
    };
  });
}

interface Props { article: Article; newer?: Article; older?: Article }
const { article, newer, older } = Astro.props;
const { title, description, pubDate, updated, tags } = article.data;
const section = article.section;
const gallery = section.look === 'gallery';
const sleeve = section.look === 'sleeve';
const coverPath = mediaUrl(article.data.cover, section);
const cleaned = cleanHtml(article.body ?? '', section, {
  title,
  plates: gallery,
  lede: sleeve,
  tracks: sleeve,
  cover: (gallery || sleeve) && coverPath ? coverPath : undefined, // header shows it, so drop it from the body
});
// Art & Design: the artist's own work goes in the hero instead of the generated thumbnail
const { html, art } = gallery ? takeArt(cleaned) : { html: cleaned, art: undefined };
const heroSrc = art?.src || coverPath;
const heroAlt = art ? art.alt || art.caption || title : article.data.coverAlt || title;
const articleClass = ['article', gallery && 'article--gallery', sleeve && 'article--sleeve'].filter(Boolean).join(' ');
const cover = absolute(heroSrc);
const hub = `/category/${section.wpCat}/`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description || undefined,
  image: cover,
  datePublished: pubDate,
  dateModified: updated || pubDate,
  url: absolute(`/${article.data.slug}/`),
  author: { '@type': 'Person', name: 'Gary Crossey' },
  isPartOf: { '@type': 'CollectionPage', name: section.name, url: absolute(hub) },
};
---
<Layout title={`${title} — Better World With Design`} description={description} image={cover} type="article" jsonLd={jsonLd}>
  {gallery ? (
    <header class="hero hero--gallery" slot="masthead">
      <div class="hero__inner">
        <div class="hero__text">
          <a class="tag-block" href={hub}>{section.name}</a>
          <h1>{title}</h1>
          <p class="meta">Gary Crossey <b></b> {dateLabel(pubDate)}</p>
        </div>
        {heroSrc && (
          <figure class="hero__art">
            <span class="shape shape--circle" aria-hidden="true"></span>
            <span class="shape shape--square" aria-hidden="true"></span>
            <img src={heroSrc} alt={heroAlt} data-fallback={art ? art.others.join('|') || 'none' : undefined} />
            {art?.caption && <figcaption>{art.caption}</figcaption>}
          </figure>
        )}
      </div>
    </header>
  ) : sleeve ? (
    <header class="hero hero--sleeve" slot="masthead">
      <div class="hero__inner">
        <div class="sleeve" aria-hidden={coverPath ? undefined : 'true'}>
          <span class="sleeve__disc"><span /></span>
          {coverPath
            ? <img class="sleeve__cover" src={coverPath} alt={article.data.coverAlt || title} />
            : <span class="sleeve__cover sleeve__cover--blank">{title}</span>}
        </div>
        <div class="hero__text">
          <a class="tag-block" href={hub}>{section.name}</a>
          <h1>{title}</h1>
          <p class="meta">Liner notes <b></b> Gary Crossey <b></b> {dateLabel(pubDate)}</p>
        </div>
      </div>
    </header>
  ) : (
    <header class="hero hero--plain" slot="masthead">
      <span class="shape shape--sun" aria-hidden="true"></span>
      <span class="shape shape--bar" aria-hidden="true"></span>
      <div class="hero__inner">
        <div class="hero__text">
          <a class="tag-block" href={hub}>{section.name}</a>
          <h1>{title}</h1>
          <p class="meta">Gary Crossey <b></b> {dateLabel(pubDate)}</p>
        </div>
      </div>
    </header>
  )}

  <main>
    <article class={articleClass} set:html={html} />

    {tags.length > 0 && (
      <p class="tags">{tags.map((t) => <span>{t}</span>)}</p>
    )}

    <nav class="pager" aria-label={`More in ${section.name}`}>
      {newer ? <a href={`/${newer.data.slug}/`}><span>Newer</span>{newer.data.title}</a> : <span />}
      {older ? <a class="older" href={`/${older.data.slug}/`}><span>Older</span>{older.data.title}</a> : <span />}
    </nav>
  </main>
  {sleeve && (
    <script is:inline>
      // Track tiles: swap the cover for the Spotify player of that release
      document.addEventListener('click', function (e) {
        var b = e.target.closest && e.target.closest('.track__btn');
        if (!b) return;
        var li = b.parentNode;
        document.querySelectorAll('.track.is-playing').forEach(function (p) { if (p !== li) { p.classList.remove('is-playing'); var f = p.querySelector('iframe'); if (f) f.remove(); } });
        if (li.querySelector('iframe')) return;
        var f = document.createElement('iframe');
        f.src = 'https://open.spotify.com/embed/album/' + b.dataset.album + '?utm_source=generator&theme=0';
        f.allow = 'autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture';
        f.loading = 'lazy'; f.title = b.getAttribute('aria-label');
        li.classList.add('is-playing'); li.appendChild(f);
      });
    </script>
  )}
</Layout>


<style is:global>
  /* ================= Heroes ================= */
  .hero { position: relative; overflow: hidden; }
  .hero__inner { position: relative; max-width: var(--wide); margin: 0 auto; padding: 3.4rem 16px 3.8rem; }
  .hero h1 { font-size: clamp(2.3rem, 5.6vw, 4.6rem); line-height: 0.98; letter-spacing: -0.03em; font-weight: 700; margin: 1.1rem 0 1.3rem; }
  .hero .meta { margin: 0; font-size: 0.78rem; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; display: flex; align-items: center; gap: 0.7rem; flex-wrap: wrap; }
  .hero .meta b { display: inline-block; width: 8px; height: 8px; background: var(--red); border-radius: 50%; }
  .shape { position: absolute; display: block; pointer-events: none; }

  /* Plain: black ground, a yellow sun rising off the edge, a blue bar */
  .hero--plain { color: var(--paper); }
  .hero--plain .hero__text { max-width: 820px; }
  .hero--plain .meta { color: #cfc8bb; }
  .hero--plain .shape--sun { width: 420px; height: 420px; border-radius: 50%; background: var(--yellow); right: -140px; top: -120px; }
  .hero--plain .shape--bar { width: 34%; height: 18px; background: var(--blue); right: 0; bottom: 0; }
  @media (max-width: 820px) { .hero--plain .shape--sun { width: 220px; height: 220px; right: -90px; top: -60px; } }

  /* Gallery: paper ground (a printed page), art framed in black with primary shapes */
  .hero--gallery { background: var(--paper); color: var(--ink); border-bottom: 10px solid var(--ink); }
  .hero--gallery .hero__inner { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); gap: 4rem; align-items: center; }
  .hero--gallery h1 { font-size: clamp(2.4rem, 5.4vw, 4.8rem); }
  .hero--gallery .meta { color: var(--ink-soft); }
  .hero__art { position: relative; margin: 0; }
  .hero__art img { position: relative; z-index: 1; width: 100%; max-height: 560px; object-fit: contain; background: var(--paper-deep); border: 10px solid var(--ink); }
  .hero__art figcaption { position: relative; z-index: 1; margin-top: 0.7rem; font-size: 0.82rem; font-weight: 500; }
  .hero__art .shape--circle { width: 62%; aspect-ratio: 1; border-radius: 50%; background: var(--red); left: -16%; top: -12%; z-index: 0; }
  .hero__art .shape--square { width: 34%; aspect-ratio: 1; background: var(--yellow); right: -7%; bottom: -9%; z-index: 0; }
  @media (max-width: 820px) {
    .hero--gallery .hero__inner { grid-template-columns: 1fr; gap: 3rem; }
    .hero__art { margin: 0 8% 0 10%; }
  }

  /* Sleeve: blue ground, black disc, the cover as the sleeve */
  .hero--sleeve { background: var(--blue); color: var(--paper); border-bottom: 10px solid var(--yellow); }
  .hero--sleeve .hero__inner { display: grid; grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr); gap: 4rem; align-items: center; }
  .hero--sleeve .meta { color: #d9e2f2; }
  .hero--sleeve .meta b { background: var(--yellow); }
  .sleeve { position: relative; width: min(100%, 440px); aspect-ratio: 1; margin-right: 26%; }
  .sleeve__disc {
    position: absolute; inset: 3% -32% 3% 32%; border-radius: 50%;
    background:
      radial-gradient(circle, var(--red) 0 16%, var(--ink) 16.5% 18%, transparent 18.5%),
      repeating-radial-gradient(circle, #0d0d0d 0 1.5px, #262626 1.7px 3.2px);
    animation: spin 8s linear infinite paused;
  }
  .sleeve__disc span { position: absolute; inset: 47.6%; border-radius: 50%; background: var(--paper); }
  .sleeve:hover .sleeve__disc { animation-play-state: running; }
  @media (prefers-reduced-motion: reduce) { .sleeve__disc { animation: none; } }
  @keyframes spin { to { transform: rotate(360deg); } }
  .sleeve__cover { position: relative; display: block; width: 100%; height: 100%; object-fit: cover; border: 6px solid var(--ink); }
  .sleeve__cover--blank { display: flex; align-items: flex-end; padding: 1.5rem; background: var(--yellow); color: var(--ink); font-weight: 800; font-size: 2rem; line-height: 1; }
  @media (max-width: 820px) {
    .hero--sleeve .hero__inner { grid-template-columns: 1fr; gap: 2.5rem; }
    .sleeve { width: 68%; }
  }

  /* ================= Article body ================= */
  main { padding: 0 16px; }
  .article { max-width: var(--text); margin: 3.4rem auto 0; overflow-wrap: break-word; }
  .article > :first-child { margin-top: 0; }
  .article h2 { font-size: 2rem; margin: 3.4rem 0 1rem; }
  .article h3 { font-size: 1.45rem; margin: 2.6rem 0 0.7rem; }
  .article h4, .article h5 { font-size: 1.1rem; margin: 1.8rem 0 0.5rem; text-transform: uppercase; letter-spacing: 0.08em; }
  .article h2 strong, .article h3 strong { font-weight: inherit; }
  .article strong { font-weight: 600; }
  .article ul, .article ol { padding-left: 1.3rem; }
  .article hr, .article .wp-block-separator { border: 0; height: 8px; background: var(--ink); margin: 3rem 0; }
  .article table { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
  .article th, .article td { border-bottom: 2px solid var(--ink); padding: 0.5rem; text-align: left; vertical-align: top; }
  .article blockquote:not(.instagram-media) { margin: 2.6rem 0; padding: 0.2rem 0 0.2rem 1.5rem; border-left: 12px solid var(--yellow); font-size: 1.4rem; line-height: 1.4; font-weight: 500; }

  /* Section headings: numbered in a primary-colour square */
  .article { counter-reset: sec; }
  .article > h2 { counter-increment: sec; display: grid; grid-template-columns: auto 1fr; gap: 0.9rem; align-items: start; }
  .article > h2::before {
    content: counter(sec, decimal-leading-zero); display: grid; place-items: center; width: 2.4rem; height: 2.4rem;
    font-size: 0.95rem; font-weight: 700; letter-spacing: 0; background: var(--red); color: var(--paper); margin-top: 0.1rem;
  }
  .article > h2:nth-of-type(3n+2)::before { background: var(--yellow); color: var(--ink); }
  .article > h2:nth-of-type(3n)::before { background: var(--blue); }

  /* Opening paragraph: a big red letter, Bayer-style */
  .article p.lede { font-size: 1.32rem; line-height: 1.55; font-weight: 500; }
  .article p.lede::first-letter { float: left; font-weight: 800; font-size: 5.4rem; line-height: 0.78; padding: 0.4rem 0.7rem 0 0; color: var(--red); }

  /* WordPress blocks */
  .article figure { margin: 2.4rem 0; }
  .article .wp-block-image img, .article figure img { margin: 0 auto; }
  .article .aligncenter { margin-left: auto; margin-right: auto; text-align: center; }
  .article .alignleft { float: left; margin: 0.3rem 1.5rem 1rem 0; max-width: 50%; }
  .article .alignright { float: right; margin: 0.3rem 0 1rem 1.5rem; max-width: 50%; }
  .article figcaption, .article .wp-element-caption { font-size: 0.82rem; color: var(--ink-soft); margin-top: 0.6rem; text-align: left; letter-spacing: 0.02em; }
  .article .has-text-align-center { text-align: center; }
  .article .has-large-font-size { font-size: 1.4rem; }
  .article .has-background { background: var(--paper-deep); padding: 1.2rem 1.4rem; border-left: 8px solid var(--blue); }
  .article .wp-block-columns { display: flex; gap: 1.5rem; margin: 2.4rem 0; }
  .article .wp-block-column { flex: 1 1 0; min-width: 0; }
  .article .wp-block-column > :first-child { margin-top: 0; }
  .article .wp-block-group { margin: 2.4rem 0; }
  @media (max-width: 720px) {
    .article .wp-block-columns { flex-direction: column; gap: 0; }
    .article .alignleft, .article .alignright { float: none; max-width: 100%; margin: 1.5rem auto; }
  }
  .article .wp-block-cover { position: relative; margin: 2.4rem 0; min-height: 280px; display: grid; place-items: center; overflow: hidden; border: 8px solid var(--ink); }
  .article .wp-block-cover__image-background { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .article .wp-block-cover__background { position: absolute; inset: 0; background: var(--ink); opacity: 0.4; }
  .article .wp-block-cover__inner-container { position: relative; padding: 2rem 1.5rem; color: #fff; text-align: center; }
  .article .wp-block-cover__inner-container * { color: #fff; }

  /* Embeds */
  .article iframe { max-width: 100%; border: 0; }
  .article .wp-block-embed { margin: 2.4rem 0; }
  .article .wp-has-aspect-ratio .wp-block-embed__wrapper { position: relative; aspect-ratio: 16 / 9; }
  .article .wp-embed-aspect-4-3 .wp-block-embed__wrapper { aspect-ratio: 4 / 3; }
  .article .wp-has-aspect-ratio iframe { position: absolute; inset: 0; width: 100%; height: 100%; }
  .article .instagram-media { margin: 2.4rem auto !important; }

  /* Buttons, Divi counter titles */
  .article .wp-block-buttons { display: flex; flex-wrap: wrap; gap: 0.8rem; margin: 2rem 0; }
  .article .wp-block-button__link { display: inline-block; background: var(--ink); color: var(--paper); padding: 0.7rem 1.3rem; text-decoration: none; font-size: 0.8rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; }
  .article .wp-block-button__link:hover { background: var(--red); color: var(--paper); }
  .article h3.title { font-size: 1.1rem; border-left: 8px solid var(--red); padding-left: 0.8rem; }

  /* Wider measure used by art, players and works */
  .article--gallery figure.plate,
  .article--gallery .works,
  .article--gallery .wp-block-columns,
  .article--gallery .wp-block-embed,
  .article--gallery > p:has(> iframe),
  .article--sleeve .wp-block-embed,
  .article--sleeve > p:has(> iframe),
  .article--sleeve figure.wp-block-image,
  .article--sleeve .wp-block-columns {
    margin-left: calc(50% - min(50vw - 16px, 500px)); margin-right: calc(50% - min(50vw - 16px, 500px));
  }
  .article > p:has(> iframe) iframe { display: block; width: 100%; }

  /* ================= Gallery (Art & Design) ================= */
  .article--gallery { counter-reset: sec plate; }
  .article--gallery figure.plate { counter-increment: plate; margin-top: 3rem; margin-bottom: 3rem; }
  .article--gallery figure.plate img, .article--gallery figure.plate a { display: block; }
  .article--gallery figure.plate img { width: 100%; height: auto; max-height: 82vh; object-fit: contain; background: var(--paper-deep); border-top: 10px solid var(--ink); }
  .article--gallery figure.plate figcaption { display: flex; gap: 0.9rem; align-items: baseline; margin-top: 0.7rem; font-size: 0.9rem; color: var(--ink); }
  .article--gallery figure.plate figcaption::before {
    content: 'Plate ' counter(plate, decimal-leading-zero); flex: none; padding: 0.15rem 0.5rem; background: var(--red); color: var(--paper);
    font-size: 0.68rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase;
  }
  .article--gallery .wp-block-column figure.plate { margin: 0; }

  /* Works: the art leads the piece */
  .article--gallery .works { display: grid; gap: 1.6rem; margin-top: 0; margin-bottom: 3.6rem; }
  .article--gallery .works--2 { grid-template-columns: 1fr 1fr; }
  .article--gallery .works--3 { grid-template-columns: repeat(3, 1fr); }
  .article--gallery .works figure.plate { margin: 0; }
  .article--gallery .works--2 figure.plate img, .article--gallery .works--3 figure.plate img { aspect-ratio: 1; object-fit: cover; }
  @media (max-width: 720px) { .article--gallery .works--2, .article--gallery .works--3 { grid-template-columns: 1fr; } }

  /* Players: a black band with a label */
  .article--gallery .wp-block-embed, .article--gallery > p:has(> iframe),
  .article--sleeve .wp-block-embed, .article--sleeve > p:has(> iframe) {
    position: relative; background: var(--ink); padding: 2.4rem clamp(10px, 2.4vw, 22px) clamp(10px, 2.4vw, 22px);
  }
  .article--gallery .wp-block-embed::before, .article--gallery > p:has(> iframe)::before,
  .article--sleeve .wp-block-embed::before, .article--sleeve > p:has(> iframe)::before {
    content: 'Listen / Watch'; position: absolute; top: 0.7rem; left: clamp(10px, 2.4vw, 22px);
    font-size: 0.68rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: var(--yellow);
  }

  /* ================= Sleeve (Music) ================= */
  .article--sleeve { counter-reset: sec li; }
  .article--sleeve > h2::before { content: 'A' counter(sec); }
  .article--sleeve figure.wp-block-image { text-align: center; }
  .article--sleeve figure.wp-block-image img { display: inline-block; width: auto; max-width: 100%; max-height: 80vh; border: 6px solid var(--ink); }
  .article--sleeve .wp-block-column figure.wp-block-image { margin: 0 0 1rem; }
  .article--sleeve ol, .article--sleeve ul { padding-left: 0; list-style: none; }
  .article--sleeve ol > li { counter-increment: li; padding: 0.6rem 0 0.6rem 3rem; border-bottom: 2px solid var(--ink); position: relative; }
  .article--sleeve ol > li::before { content: counter(li, decimal-leading-zero); position: absolute; left: 0; top: 0.6rem; width: 2rem; text-align: center; font-weight: 700; font-size: 0.85rem; background: var(--blue); color: var(--paper); }
  .article--sleeve ul > li { padding: 0.35rem 0 0.35rem 1.6rem; position: relative; }
  .article--sleeve ul > li::before { content: ''; position: absolute; left: 0; top: 0.85rem; width: 10px; height: 10px; border-radius: 50%; background: var(--red); }

  /* Track grid: each cover plays its own song */
  .article--sleeve .tracks { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 1.4rem 1.1rem; margin: 3rem calc(50% - min(50vw - 16px, 560px)); }
  .article--sleeve .tracks > li { padding: 0; border: 0; }
  .article--sleeve .tracks > li::before { content: none; }
  .track { position: relative; }
  .track__btn { all: unset; cursor: pointer; display: block; position: relative; width: 100%; aspect-ratio: 1; }
  .track img { width: 100%; aspect-ratio: 1; object-fit: cover; border: 4px solid var(--ink); transition: transform .25s ease; }
  .track__btn:hover img, .track__btn:focus-visible img { transform: translate(-4px, -4px); box-shadow: 8px 8px 0 var(--red); }
  .track__btn:focus-visible { outline: 3px solid var(--blue); outline-offset: 3px; }
  .track__play { position: absolute; right: 10px; bottom: 10px; width: 46px; height: 46px; border-radius: 50%; background: var(--red); display: grid; place-items: center; }
  .track__play::after { content: ''; margin-left: 4px; border-left: 14px solid var(--paper); border-top: 9px solid transparent; border-bottom: 9px solid transparent; }
  .track__title { display: block; margin-top: 0.55rem; font-weight: 700; font-size: 0.95rem; line-height: 1.2; }
  .track__title em { display: block; font-style: normal; font-weight: 600; font-size: 0.66rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-soft); margin-top: 0.2rem; }
  .track--off img { filter: grayscale(1) opacity(.75); }
  .track.is-playing { grid-column: span 2; }
  .track.is-playing .track__btn { display: none; }
  .track.is-playing iframe { display: block; width: 100%; height: 352px; border: 0; border-radius: 12px; background: var(--ink); }
  @media (max-width: 520px) { .article--sleeve .tracks { grid-template-columns: 1fr 1fr; } .track.is-playing { grid-column: 1 / -1; } }

  /* ================= Tags + pager ================= */
  .tags { max-width: var(--text); margin: 3rem auto 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .tags span { border: 2px solid var(--ink); padding: 0.15rem 0.6rem; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; }
  .pager { max-width: var(--text); margin: 4rem auto 0; display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; border-top: 10px solid var(--ink); padding-top: 1.4rem; }
  .pager a { text-decoration: none; color: var(--ink); font-weight: 700; font-size: 1.15rem; line-height: 1.2; }
  .pager a:hover { color: var(--red); }
  .pager a span { display: inline-block; margin-bottom: 0.5rem; padding: 0.15rem 0.5rem; background: var(--ink); color: var(--paper); font-size: 0.66rem; letter-spacing: 0.2em; text-transform: uppercase; }
  .pager .older { text-align: right; }
</style>
