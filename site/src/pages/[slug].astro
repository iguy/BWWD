---
// Every article keeps its WordPress URL: /<slug>/
import Layout from '../layouts/Layout.astro';
import { getArticles, mediaUrl, absolute, dateLabel, type Article } from '../lib/sections';
import SeriesBanner from '../components/SeriesBanner.astro';
import { cleanHtml, takeArt } from '../lib/clean';
import '../styles/article.css';
import metaDescriptions from '../data/meta.json';
import faqData from '../data/faq.json';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article) => {
    const inSection = articles.filter((a) => a.section.folder === article.section.folder);
    const i = inSection.findIndex((a) => a.id === article.id);
    return {
      params: { slug: decodeURIComponent(article.data.slug) }, // emoji slugs: file path matches the decoded URL
      props: { article, newer: inSection[i - 1], older: inSection[i + 1] },
    };
  });
}

interface Props { article: Article; newer?: Article; older?: Article }
const { article, newer, older } = Astro.props;
const { title, description, pubDate, updated, revised, tags } = article.data;
const revisedLabel = revised ? new Date(revised + '-15T12:00:00').toLocaleDateString('en-US', { month: 'long', year: 'numeric' }) : '';
const section = article.section;
const gallery = section.look === 'gallery';
const sleeve = section.look === 'sleeve';
const coverPath = mediaUrl(article.data.cover, section);
const cleaned = cleanHtml(article.body ?? '', section, {
  title,
  plates: gallery,
  lede: sleeve,
  tracks: sleeve,
  cover: (gallery || sleeve) && coverPath ? coverPath : undefined, // header shows it, so drop it from the body
});
// Art & Design: the artist's own work goes in the hero instead of the generated thumbnail
const { html, art } = gallery ? takeArt(cleaned) : { html: cleaned, art: undefined };
const heroSrc = art?.src || coverPath;
const heroAlt = art ? art.alt || art.caption || title : article.data.coverAlt || title;
// Music: a playable track grid sits beside the writing, not after it
const tracksMatch = sleeve ? html.match(/<ul class="tracks">[\s\S]*?<\/ul>/) : null;
const tracksHtml = tracksMatch?.[0] ?? '';
const bodyHtml = tracksHtml ? html.replace(tracksHtml, '') : html;
const trackCount = (tracksHtml.match(/class="track[ "]/g) ?? []).length;
const articleClass = ['article', gallery && 'article--gallery', sleeve && 'article--sleeve'].filter(Boolean).join(' ');
const cover = absolute(heroSrc);
const hub = `/category/${section.wpCat}/`;

const meta = (metaDescriptions as Record<string, string>)[article.data.slug] || description;
const url = absolute(`/${article.data.slug}/`);
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      '@id': url + '#article',
      headline: title,
      description: meta || undefined,
      image: cover,
      datePublished: pubDate,
      dateModified: updated || pubDate,
      url,
      mainEntityOfPage: url,
      inLanguage: 'en',
      articleSection: section.name,
      keywords: tags.length ? tags.join(', ') : undefined,
      author: { '@id': absolute('/about/') + '#gary' },
      publisher: { '@id': absolute('/') + '#site' },
      isPartOf: { '@type': 'CollectionPage', name: section.name, url: absolute(hub) },
      // Book posts: say which book the page is about
      about: article.data.book ? {
        '@type': 'Book',
        name: article.data.book,
        author: article.data.author ? { '@type': 'Person', name: article.data.author } : undefined,
      } : undefined,
    },
    ...(((faqData as Record<string, unknown>)[article.data.slug] as string[][] | undefined) ? [{
      '@type': 'FAQPage',
      mainEntity: ((faqData as Record<string, unknown>)[article.data.slug] as string[][]).map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
    }] : []),
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: absolute('/') },
        { '@type': 'ListItem', position: 2, name: section.name, item: absolute(hub) },
        { '@type': 'ListItem', position: 3, name: title, item: url },
      ],
    },
  ],
};
---
<Layout title={`${title} — Better World With Design`} description={meta} image={cover} type="article" jsonLd={jsonLd}>
  {gallery ? (
    <header class="hero hero--gallery" slot="masthead">
      <div class="hero__inner">
        <div class="hero__text">
          <a class="tag-block" href={hub}>{section.name}</a>
          <h1>{title}</h1>
          <p class="meta">Gary Crossey <b></b> {dateLabel(pubDate)}</p>
        </div>
        {heroSrc && (
          <figure class="hero__art">
            <span class="shape shape--circle" aria-hidden="true"></span>
            <span class="shape shape--square" aria-hidden="true"></span>
            <img src={heroSrc} alt={heroAlt} data-fallback={art ? art.others.join('|') || 'none' : undefined} />
            {art?.caption && <figcaption>{art.caption}</figcaption>}
          </figure>
        )}
      </div>
    </header>
  ) : sleeve ? (
    <header class="hero hero--sleeve" slot="masthead">
      <div class="hero__inner">
        <div class="sleeve" aria-hidden={coverPath ? undefined : 'true'}>
          <span class="sleeve__disc"><span /></span>
          {coverPath
            ? <img class="sleeve__cover" src={coverPath} alt={article.data.coverAlt || title} />
            : <span class="sleeve__cover sleeve__cover--blank">{title}</span>}
        </div>
        <div class="hero__text">
          <a class="tag-block" href={hub}>{section.name}</a>
          <h1>{title}</h1>
          <p class="meta">Liner notes <b></b> Gary Crossey <b></b> {dateLabel(pubDate)}</p>
        </div>
      </div>
    </header>
  ) : (
    <header class="hero hero--plain" slot="masthead">
      <span class="shape shape--sun" aria-hidden="true"></span>
      <span class="shape shape--bar" aria-hidden="true"></span>
      <div class="hero__inner">
        <div class="hero__text">
          <a class="tag-block" href={hub}>{section.name}</a>
          <h1>{title}</h1>
          <p class="meta">Gary Crossey <b></b> {dateLabel(pubDate)}{revisedLabel && <><b></b> Updated {revisedLabel}</>}</p>
        </div>
      </div>
    </header>
  )}

  <main>
    {tracksHtml ? (
      <div class="with-drops">
        <article class={articleClass} set:html={bodyHtml} />
        <aside class="drops" aria-label="Tracks">
          <p class="drops__head"><span>{trackCount}</span> tracks — tap a cover to play</p>
          <Fragment set:html={tracksHtml} />
        </aside>
      </div>
    ) : (
      <article class={articleClass} set:html={html} />
    )}

    {(tags.includes('Montaigne') || /^Montaigne\s*[–-]/i.test(title)) && <SeriesBanner current={article.data.slug} />}

    {tags.length > 0 && (
      <p class="tags">{tags.map((t) => <span>{t}</span>)}</p>
    )}

    <nav class="pager" aria-label={`More in ${section.name}`}>
      {newer ? <a href={`/${newer.data.slug}/`}><span>Newer</span>{newer.data.title}</a> : <span />}
      {older ? <a class="older" href={`/${older.data.slug}/`}><span>Older</span>{older.data.title}</a> : <span />}
    </nav>
  </main>
  {sleeve && (
    <script is:inline>
      // Track tiles: swap the cover for the Spotify player of that release
      document.addEventListener('click', function (e) {
        var b = e.target.closest && e.target.closest('.track__btn');
        if (!b) return;
        var li = b.parentNode;
        document.querySelectorAll('.track.is-playing').forEach(function (p) { if (p !== li) { p.classList.remove('is-playing'); var f = p.querySelector('iframe'); if (f) f.remove(); } });
        if (li.querySelector('iframe')) return;
        var f = document.createElement('iframe');
        f.src = 'https://open.spotify.com/embed/album/' + b.dataset.album + '?utm_source=generator&theme=0';
        f.allow = 'autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture';
        f.loading = 'lazy'; f.title = b.getAttribute('aria-label');
        li.classList.add('is-playing'); li.appendChild(f);
      });
    </script>
  )}
</Layout>



