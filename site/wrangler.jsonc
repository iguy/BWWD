// Main site as a Cloudflare Worker with static assets.
// Static files are served first; src/worker.js handles anything not found
// (old WordPress images/admin pass through to WordPress; everything else gets the 404 page).
// No route yet: betterworldwithdesign.com stays on WordPress until a route is added.
{
  "name": "bwwd-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none"
  }
}
