---
// Renders one photo story. Used by both URL schemes:
//   legacy stories at the root (/asheville-rugby/) — kept to preserve WordPress URLs and rankings
//   new stories under /photography/<slug>/
import Layout from '../layouts/Layout.astro';
import { render, type CollectionEntry } from 'astro:content';
import { storyPath, absolute } from '../lib/stories';

interface Props {
  story: CollectionEntry<'photography'>;
  newer?: CollectionEntry<'photography'>;
  older?: CollectionEntry<'photography'>;
}
const { story, newer, older } = Astro.props;
const { Content } = await render(story);
const { title, description, pubDate, photoCount } = story.data;
const cover = absolute(story.data.cover);
const dateLabel = new Date(pubDate + 'T12:00:00').toLocaleDateString('en-US', {
  month: 'long', day: 'numeric', year: 'numeric',
});

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  image: cover,
  datePublished: pubDate,
  url: absolute(storyPath(story)),
  author: { '@type': 'Person', name: 'Gary Crossey' },
  isPartOf: { '@type': 'CollectionPage', name: 'Photography', url: 'https://photography.betterworldwithdesign.com/' },
};
---
<Layout title={`${title} — Photography — Better World With Design`} description={description} image={cover} type="article" jsonLd={jsonLd} theme={story.data.theme}>
  <header class="story-head" slot="masthead">
    <a class="back" href="/">← Photography</a>
    <h1>{title}</h1>
    <p class="meta">Gary Crossey · {dateLabel} · {photoCount} {photoCount === 1 ? 'photograph' : 'photographs'}</p>
  </header>

  <main>

    <article class="story">
      <Content />
    </article>

    <nav class="pager" aria-label="More photo stories">
      {newer ? <a href={storyPath(newer)}><span>Newer</span>{newer.data.title}</a> : <span />}
      {older ? <a class="older" href={storyPath(older)}><span>Older</span>{older.data.title}</a> : <span />}
    </nav>
  </main>

  <dialog class="lightbox" aria-label="Photo viewer">
    <img class="lb-img" alt="" />
    <p class="lb-count" aria-live="polite"></p>
    <button class="lb-btn lb-close" type="button" aria-label="Close">✕</button>
    <button class="lb-btn lb-prev" type="button" aria-label="Previous photo">‹</button>
    <button class="lb-btn lb-next" type="button" aria-label="Next photo">›</button>
  </dialog>
</Layout>

<script>
  const photos = Array.from(document.querySelectorAll<HTMLImageElement>('.story figure img'));
  const box = document.querySelector<HTMLDialogElement>('.lightbox')!;
  const img = box.querySelector<HTMLImageElement>('.lb-img')!;
  const count = box.querySelector<HTMLElement>('.lb-count')!;
  let index = 0;

  // WordPress resized files end in -1024x683.jpg; the original drops that suffix.
  const fullSize = (src: string) => src.replace(/-\d+x\d+(\.\w+)$/, '$1');

  function show(i: number) {
    index = (i + photos.length) % photos.length;
    const small = photos[index].currentSrc || photos[index].src;
    const full = photos[index].dataset.full;
    img.onerror = () => { img.onerror = null; img.src = small; };
    img.src = full || fullSize(small);
    img.alt = photos[index].alt;
    count.textContent = `${index + 1} / ${photos.length}`;
    // Preload neighbours so next/previous feel instant.
    [index + 1, index - 1].forEach((n) => {
      const p = photos[(n + photos.length) % photos.length];
      if (p) new Image().src = p.dataset.full || fullSize(p.currentSrc || p.src);
    });
  }

  photos.forEach((p, i) => {
    p.tabIndex = 0;
    p.setAttribute('role', 'button');
    p.setAttribute('aria-label', `Enlarge photo ${i + 1} of ${photos.length}`);
    const open = () => { show(i); box.showModal(); };
    p.addEventListener('click', open);
    p.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(); } });
  });

  box.querySelector('.lb-close')!.addEventListener('click', () => box.close());
  box.querySelector('.lb-prev')!.addEventListener('click', () => show(index - 1));
  box.querySelector('.lb-next')!.addEventListener('click', () => show(index + 1));
  box.addEventListener('click', (e) => { if (e.target === box) box.close(); });
  box.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') show(index + 1);
    if (e.key === 'ArrowLeft') show(index - 1);
  });

  let touchX: number | null = null;
  box.addEventListener('touchstart', (e) => { touchX = e.touches[0].clientX; }, { passive: true });
  box.addEventListener('touchend', (e) => {
    if (touchX === null) return;
    const dx = e.changedTouches[0].clientX - touchX;
    if (Math.abs(dx) > 50) show(index + (dx < 0 ? 1 : -1));
    touchX = null;
  });

  if (photos.length < 2) box.querySelectorAll('.lb-prev, .lb-next, .lb-count').forEach((el) => el.remove());
</script>

<style>
  main { max-width: var(--wide); margin: 0 auto; padding: 0 16px; }
  .story-head { max-width: calc(var(--text) + 32px); margin: 0 auto; padding: 2.75rem 16px 3rem; }
  .back { font-size: 0.78rem; letter-spacing: 0.12em; text-transform: uppercase; text-decoration: none; color: #c8813a; }
  .back:hover { color: #efe6d6; }
  .story-head h1 { font-size: clamp(2.5rem, 7vw, 4.25rem); line-height: 1; margin: 0.9rem 0 0.9rem; color: #efe6d6; }
  .meta { margin: 0; color: #a8987f; font-size: 0.95rem; }
  .story { padding-top: 2.75rem; }

  .story :global(p),
  .story :global(h2),
  .story :global(h3),
  .story :global(h4),
  .story :global(ul),
  .story :global(ol) { max-width: var(--text); margin-left: auto; margin-right: auto; }
  .story :global(p) { margin-top: 0; margin-bottom: 1.25em; }
  .story :global(h2) { font-size: 1.75rem; margin-top: 2.5rem; margin-bottom: 0.75rem; }
  .story :global(h3) { font-size: 1.35rem; margin-top: 2rem; margin-bottom: 0.5rem; }
  .story :global(li) { margin-bottom: 0.4em; }

  .story :global(figure) { margin: 2.5rem auto; max-width: 1000px; }
  .story :global(.lede) { font-size: 1.3rem; line-height: 1.55; }
  .story :global(.stat) { font-family: var(--font-display); font-size: clamp(2rem, 4vw, 3rem); line-height: 1; color: var(--brass); margin: 0 0 0.35rem; }
  .story :global(figure img) { width: 100%; }
  .story :global(figure.narrow) { max-width: 620px; }
  /* Rows: each photo's width follows its aspect ratio, so every photo in a row is the same height. */
  .story :global(.photos) {
    display: flex;
    gap: 12px;
    margin: 2.5rem auto;
    max-width: 1000px;
  }
  .story :global(.photos figure) { flex: var(--ar, 1) 1 0; min-width: 0; }
  .story :global(.photos figure img) { width: 100%; height: auto; }
  /* Large galleries: uniform three-column grid of 3:2 tiles (click opens the full photo) */
  .story :global(.photos-grid) { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .story :global(.photos-grid figure img) { aspect-ratio: 3 / 2; object-fit: cover; height: 100%; }
  @media (max-width: 700px) { .story :global(.photos-grid) { grid-template-columns: repeat(2, 1fr); } }
  /* Portfolio galleries: masonry columns, every photo at its own shape, never cropped */
  .story :global(.photos-masonry) { display: block; columns: 3 280px; column-gap: 12px; }
  .story :global(.photos-masonry figure) { break-inside: avoid; margin: 0 0 12px; }
  .story :global(.photos-masonry figure img) { width: 100%; height: auto; }
  .story :global(.photos figure) { margin: 0; }
  .story :global(figcaption) {
    margin-top: 0.6rem;
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .story :global(.embed-link a) { font-weight: 600; }

  /* Split: a tall photo beside its text, so it isn't blown up to full width */
  .story :global(.split) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    align-items: center;
    max-width: 1000px;
    margin: 2.5rem auto;
  }
  .story :global(.split figure) { margin: 0; }
  .story :global(.split-right figure) { order: 2; }
  .story :global(.split-text p) { max-width: none; margin: 0 0 1em; }
  @media (max-width: 700px) {
    .story :global(.split) { grid-template-columns: 1fr; gap: 1.25rem; }
    .story :global(.split-right figure) { order: 0; }
  }

  /* Phone screenshots: shown as phone screens in a centred grid, big enough to read */
  .story :global(.screens) {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2.5rem 2rem;
    max-width: 1000px;
    margin: 3rem auto;
  }
  .story :global(.screens figure) { margin: 0; width: calc((100% - 6rem) / 4); }
  .story :global(.screens img) {
    width: 100%;
    border-radius: 22px;
    border: 6px solid #1c1a17;
    box-shadow: 0 18px 40px -18px rgba(28, 26, 23, 0.55);
    background: #1c1a17;
  }
  @media (max-width: 900px) { .story :global(.screens figure) { width: calc((100% - 4rem) / 3); } }
  @media (max-width: 600px) { .story :global(.screens figure) { width: calc((100% - 2rem) / 2); } }
  .story :global(figure img) { cursor: zoom-in; transition: opacity 0.2s; }
  .story :global(figure img:hover) { opacity: 0.92; }
  .story :global(figure img:focus-visible) { outline: 3px solid var(--brass); outline-offset: 3px; }

  .lightbox {
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(16, 14, 12, 0.96);
    color: #ece4d2;
  }
  .lightbox[open] { display: flex; align-items: center; justify-content: center; }
  .lightbox::backdrop { background: rgba(16, 14, 12, 0.96); }
  .lb-img { max-width: calc(100vw - 32px); max-height: calc(100vh - 96px); width: auto; height: auto; object-fit: contain; }
  .lb-count {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    font-size: 0.85rem;
    letter-spacing: 0.12em;
  }
  .lb-btn {
    position: absolute;
    background: none;
    border: 0;
    color: inherit;
    font-size: 2.5rem;
    line-height: 1;
    padding: 0.75rem 1rem;
    cursor: pointer;
    opacity: 0.7;
  }
  .lb-btn:hover, .lb-btn:focus-visible { opacity: 1; }
  .lb-close { top: 0.5rem; right: 0.5rem; font-size: 1.75rem; }
  .lb-prev { left: 0.25rem; top: 50%; transform: translateY(-50%); }
  .lb-next { right: 0.25rem; top: 50%; transform: translateY(-50%); }
  @media (max-width: 600px) {
    .lb-prev, .lb-next { top: auto; bottom: 0.25rem; transform: none; }
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    border-top: 1px solid var(--rule);
    margin-top: 4rem;
    padding-top: 2rem;
  }
  .pager a { font-family: var(--font-display); font-size: 1.25rem; text-decoration: none; color: var(--ink); }
  .pager a:hover { color: var(--brass); }
  .pager span { display: block; font-family: var(--font-body); font-size: 0.8rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--brass); }
  .pager .older { text-align: right; }

  @media (max-width: 560px) {
    .story :global(.photos:not(.photos-grid)) { flex-direction: column; }
  }
</style>
