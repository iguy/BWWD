---
interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: string;
  jsonLd?: object;
  theme?: 'light' | 'dark';
}
const {
  title,
  description = 'Better World With Design — reviews, music, photography and design by Gary Crossey.',
  image,
  type = 'website',
  jsonLd,
  theme = 'light',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta property="og:site_name" content="Better World With Design" />
  <meta property="og:type" content={type} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  {image && <meta property="og:image" content={image} />}
  <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,800&family=Source+Serif+4:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet" />
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-02EPG8KK2Y"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-02EPG8KK2Y');
  </script>
  <style is:global>
    :root {
      --paper: #ece4d2;
      --paper-deep: #e2d8c1;
      --ink: #1c2b33;
      --ink-soft: #4a443b;
      --brass: #7a5518;
      --rule: #cbbd9e;
      --font-display: 'Fraunces', Georgia, serif;
      --font-body: 'Source Serif 4', Georgia, serif;
      --wide: 1180px;
      --text: 680px;
    }
    *, *::before, *::after { box-sizing: border-box; }
    html { background: var(--paper); }
    body {
      margin: 0;
      background: var(--paper);
      color: var(--ink);
      font-family: var(--font-body);
      font-size: 1.125rem;
      line-height: 1.65;
      -webkit-font-smoothing: antialiased;
    }
    img { max-width: 100%; height: auto; display: block; }
    a { color: var(--brass); text-underline-offset: 3px; }
    a:hover { color: var(--ink); }
    h1, h2, h3, h4 { font-family: var(--font-display); line-height: 1.15; font-weight: 600; letter-spacing: -0.01em; }
    .site-header, .site-footer {
      max-width: var(--wide);
      margin: 0 auto;
      padding: 1.25rem 16px;
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 1rem;
      flex-wrap: wrap;
    }
    /* Masthead: dark band holding the nav and (optionally) the page title */
    .masthead { background: #1a1714; color: #efe6d6; border-bottom: 4px solid #c8813a; }
    .masthead .site-header { border-bottom: 1px solid #3d2f22; padding-top: 1.1rem; padding-bottom: 1.1rem; }
    .brand { font-family: var(--font-display); font-weight: 600; font-size: 1.25rem; color: #efe6d6; text-decoration: none; }
    .brand:hover { color: #c8813a; }
    .site-nav { display: flex; gap: 1.4rem; font-size: 0.95rem; }
    .site-nav a { color: #d8cbb4; text-decoration: none; }
    .site-nav a:hover, .site-nav a.is-section { color: #c8813a; }
    .site-nav a.nav-book { color: #1a1714; background: #c8813a; padding: 0.15rem 0.7rem; }
    .site-nav a.nav-book:hover { background: #efe6d6; color: #1a1714; }
    /* Dark story pages: same layout, night palette */
    html:has(body.dark) { background: #16130f; }
    body.dark {
      --paper: #16130f;
      --paper-deep: #221e19;
      --ink: #ece4d2;
      --ink-soft: #b9ae98;
      --brass: #d1a85f;
      --rule: #3a342c;
      background: var(--paper);
      color: var(--ink);
    }
    body.dark h1, body.dark h2, body.dark h3 { color: var(--ink); }
    .site-footer { border-top: 1px solid var(--rule); margin-top: 5rem; font-size: 0.9rem; color: var(--ink-soft); }
  </style>
</head>
<body class={theme === 'dark' ? 'dark' : undefined}>
  <div class="masthead">
    <header class="site-header">
      <a class="brand" href="https://betterworldwithdesign.com/">Better World With Design</a>
      <nav class="site-nav" aria-label="Main">
        <a class={Astro.url.pathname.startsWith('/book') ? undefined : 'is-section'} href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>Photography</a>
        <a href="https://podcast.betterworldwithdesign.com/">Podcast</a>
        <a class="nav-book" href="/book/">Book a session</a>
      </nav>
    </header>
    <slot name="masthead" />
  </div>
  <slot />
  <footer class="site-footer">
    <span>© {new Date().getFullYear()} Gary Crossey</span>
    <a href="https://podcast.betterworldwithdesign.com/">Listen to the podcast →</a>
  </footer>
</body>
</html>
