---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const stories = (await getCollection('photography')).sort((a, b) =>
  b.data.pubDate.localeCompare(a.data.pubDate)
);
const [lead, ...rest] = stories;
const totalPhotos = stories.reduce((n, s) => n + s.data.photoCount, 0);
const years = stories.map((s) => s.data.pubDate.slice(0, 4)).sort();
const yearSpan = `${years[0]}–${years[years.length - 1]}`;

const description =
  'Photography by Gary Crossey — architecture, abstract, and street work exploring pattern, structure, and light.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Photography — Better World With Design',
  url: 'https://betterworldwithdesign.com/photography/',
  description,
  author: { '@type': 'Person', name: 'Gary Crossey' },
  hasPart: stories.map((s) => ({
    '@type': 'Article',
    headline: s.data.title,
    url: `https://betterworldwithdesign.com/${s.id}/`,
    datePublished: s.data.pubDate,
    image: s.data.cover,
  })),
};
---
<Layout title="Photography — Better World With Design" description={description} image={lead.data.cover} jsonLd={jsonLd}>
  <main>
    <section class="intro">
      <p class="eyebrow">Photography</p>
      <h1>Architecture, abstract, and street work — exploring pattern, structure, and light.</h1>
      <p class="meta">{stories.length} photo stories · {totalPhotos} photographs · {yearSpan}</p>
    </section>

    <a class="lead" href={`/${lead.id}/`}>
      <img src={lead.data.cover} alt={lead.data.title} />
      <div class="lead-text">
        <p class="card-meta">{lead.data.pubDate.slice(0, 4)} · {lead.data.photoCount} photos</p>
        <h2>{lead.data.title}</h2>
        <p>{lead.data.description}</p>
      </div>
    </a>

    <ul class="grid">
      {rest.map((s) => (
        <li>
          <a class="card" href={`/${s.id}/`}>
            <div class="frame"><img src={s.data.cover} alt={s.data.title} loading="lazy" decoding="async" /></div>
            <p class="card-meta">{s.data.pubDate.slice(0, 4)} · {s.data.photoCount} {s.data.photoCount === 1 ? 'photo' : 'photos'}</p>
            <h2>{s.data.title}</h2>
            <p class="card-desc">{s.data.description}</p>
          </a>
        </li>
      ))}
    </ul>
  </main>
</Layout>

<style>
  main { max-width: var(--wide); margin: 0 auto; padding: 0 16px; }
  .intro { padding: 4rem 0 2.5rem; max-width: 820px; }
  .eyebrow {
    margin: 0 0 1rem;
    font-size: 0.8rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--brass);
    font-weight: 600;
  }
  .intro h1 { font-size: clamp(2rem, 4.5vw, 3.25rem); margin: 0 0 1.25rem; font-weight: 400; }
  .meta { margin: 0; color: var(--ink-soft); font-size: 1rem; }

  .lead {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: 2.5rem;
    align-items: end;
    text-decoration: none;
    color: inherit;
    padding: 2.5rem 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .lead img { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; }
  .lead h2 { font-size: clamp(1.75rem, 3vw, 2.5rem); margin: 0.25rem 0 0.75rem; }
  .lead p { margin: 0; color: var(--ink-soft); }
  .lead:hover h2, .card:hover h2 { color: var(--brass); }

  .grid {
    list-style: none;
    margin: 3rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3rem 2rem;
  }
  .card { display: block; text-decoration: none; color: inherit; }
  .frame { overflow: hidden; background: var(--paper-deep); }
  .frame img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; transition: transform 0.5s ease; }
  .card:hover .frame img { transform: scale(1.03); }
  .card-meta {
    margin: 1rem 0 0.25rem;
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brass);
  }
  .card h2 { font-size: 1.4rem; margin: 0 0 0.5rem; transition: color 0.2s; }
  .card-desc {
    margin: 0;
    font-size: 0.98rem;
    color: var(--ink-soft);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 900px) {
    .grid { grid-template-columns: repeat(2, 1fr); }
    .lead { grid-template-columns: 1fr; gap: 1.25rem; }
  }
  @media (max-width: 560px) {
    .grid { grid-template-columns: 1fr; }
    .intro { padding-top: 2.5rem; }
  }
</style>
