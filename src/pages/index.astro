---
import Layout from '../layouts/Layout.astro';
import { sortedStories, storyPath, absolute } from '../lib/stories';

const stories = await sortedStories();
const [lead, ...rest] = stories;
const totalPhotos = stories.reduce((n, s) => n + s.data.photoCount, 0);
const years = stories.map((s) => s.data.pubDate.slice(0, 4)).sort();
const yearSpan = `${years[0]}–${years[years.length - 1]}`;

// Hero mosaic: the strongest frames across events, people and architecture.
const mosaic = [
  { src: '/photography/asheville-pride/asheville-pride-5b88918f.jpg', alt: 'Marcher in a giant pink flower headdress, Asheville Pride', href: '/asheville-pride/' },
  { src: '/photography/chicago-architecture/chicago-architecture-d6274776.jpg', alt: "Marina City's scalloped balconies, Chicago", href: '/chicago-architecture/' },
  { src: '/photography/asheville-rugby-september-2026/asheville-rugby-09.jpg', alt: 'A hard tackle, Asheville Rugby', href: '/asheville-rugby-september-2026/' },
  { src: '/photography/people/people-35e2cca1.jpg', alt: 'Boy George on stage, London', href: '/people/' },
  { src: '/photography/chicago-architecture/chicago-architecture-0690b944.jpg', alt: 'The Tiffany dome, Chicago Cultural Center', href: '/chicago-architecture/' },
];

const description =
  'Photography by Gary Crossey: architecture, street, events and portraits. Pattern, structure, light, and people. Based near Asheville, NC; available for event and portrait photography.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Photography — Better World With Design',
  url: 'https://photography.betterworldwithdesign.com/',
  description,
  author: { '@type': 'Person', name: 'Gary Crossey' },
  hasPart: stories.map((s) => ({
    '@type': 'Article',
    headline: s.data.title,
    url: absolute(storyPath(s)),
    datePublished: s.data.pubDate,
    image: absolute(s.data.cover),
  })),
};
const mail = 'mailto:garycrossey@irishguy.us?subject=Photography';
---
<Layout title="Photography — Better World With Design" description={description} image={absolute(mosaic[0].src)} jsonLd={jsonLd}>
  <!-- 1. Photographs first -->
  <section class="hero">
    <div class="wrap">
      <div class="mosaic">
        {mosaic.map((m, i) => (
          <a class={`tile t${i + 1}`} href={m.href}>
            <img src={m.src} alt={m.alt} loading={i < 3 ? 'eager' : 'lazy'} decoding="async" />
          </a>
        ))}
      </div>
      <div class="hero-text">
        <div>
          <p class="eyebrow">Photography · Gary Crossey</p>
          <h1>Pattern, structure, light, and people.</h1>
        </div>
        <div class="hero-side">
          <p>Events, portraits and architecture. Based near Asheville, North Carolina.</p>
          <div class="buttons">
            <a class="btn" href="#work">See the work</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. The work -->
  <main id="work">
    <a class="lead" href={storyPath(lead)}>
      <img src={lead.data.cover} alt={lead.data.title} />
      <div class="lead-text">
        <p class="card-meta">Latest · {lead.data.pubDate.slice(0, 4)} · {lead.data.photoCount} photos</p>
        <h2>{lead.data.title}</h2>
        <p>{lead.data.description}</p>
        <span class="more">View the series →</span>
      </div>
    </a>

    <div class="section-head">
      <h2>Photo stories</h2>
      <p>{stories.length} stories · {totalPhotos} photographs · {yearSpan}</p>
    </div>
    <ul class="grid">
      {rest.map((s) => (
        <li>
          <a class="card" href={storyPath(s)}>
            {s.data.coverSet ? (
              <div class={`frame frame-set${s.data.coverLayout === 'grid' ? ' frame-grid' : ''}`}>
                {s.data.coverSet.map((src) => <img src={src} alt="" loading="lazy" decoding="async" />)}
              </div>
            ) : (
              <div class="frame"><img src={s.data.cover} alt={s.data.title} loading="lazy" decoding="async" /></div>
            )}
            <p class="card-meta">{s.data.pubDate.slice(0, 4)} · {s.data.photoCount} {s.data.photoCount === 1 ? 'photo' : 'photos'}</p>
            <h3>{s.data.title}</h3>
            <p class="card-desc">{s.data.description}</p>
          </a>
        </li>
      ))}
    </ul>
  </main>

  <!-- 3. The statement, after the work -->
  <section class="statement-panel">
    <div class="wrap statement">
      <blockquote>
        What I want from a photograph is simple: that you see something you would have missed, and feel something about it.
      </blockquote>
      <div class="statement-body">
        <p>I photograph the things most people walk past: a row of balconies that repeats until it becomes a pattern, shadows thrown through a bridge deck, a face in the middle of a moment.</p>
        <p>For me, photography is about noticing. I look for structure first: the line, the grid, the repetition. Then I look for the one thing that breaks it. In buildings, that's light. In people, it's expression.</p>
        <p>I work in two ways. In a city on my own, I slow down and look up. At events like Pride, rugby and community festivals, I stay close to the action, because the people are the story and the moment doesn't come twice.</p>
      </div>
    </div>
  </section>

  <!-- 4. Contact line -->
  <section class="contact-panel">
    <div class="wrap contact">
      <p>Gary Crossey · Based near Asheville, North Carolina</p>
      <a href={mail}>garycrossey@irishguy.us</a>
    </div>
  </section>
</Layout>

<style>
  :root { --night: #1c1a17; --night-soft: #2a2622; }
  .wrap { max-width: var(--wide); margin: 0 auto; padding: 0 16px; }
  main { max-width: var(--wide); margin: 0 auto; padding: 0 16px; scroll-margin-top: 1rem; }
  .eyebrow {
    margin: 0 0 0.9rem;
    font-size: 0.78rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--brass);
    font-weight: 600;
  }

  /* Buttons */
  .btn {
    display: inline-block;
    padding: 0.8rem 1.4rem;
    background: var(--paper);
    color: var(--night);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    border: 1px solid var(--paper);
    transition: background 0.2s, color 0.2s;
  }
  .btn:hover { background: transparent; color: var(--paper); }
  .btn-ghost { background: transparent; color: var(--paper); }
  .btn-ghost:hover { background: var(--paper); color: var(--night); }

  /* 1. Hero: dark band, photo mosaic, short headline */
  .hero { background: var(--night); color: var(--paper); padding: 2.5rem 0 3.5rem; }
  .mosaic {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    grid-template-rows: 240px 240px;
    gap: 8px;
  }
  .tile { display: block; overflow: hidden; background: var(--night-soft); }
  .tile img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease, opacity 0.3s; }
  .tile:hover img { transform: scale(1.04); }
  .t1 { grid-row: 1 / 3; }
  .t2 { grid-column: 2; grid-row: 1; }
  .t3 { grid-column: 3; grid-row: 1; }
  .t4 { grid-column: 2; grid-row: 2; }
  .t5 { grid-column: 3; grid-row: 2; }
  .hero-text {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 2.5rem;
    align-items: end;
    margin-top: 2.25rem;
  }
  .hero h1 { color: var(--paper); font-size: clamp(2.1rem, 4.6vw, 3.6rem); font-weight: 400; margin: 0; }
  .hero-side p { margin: 0 0 1.25rem; color: #d6ccb6; font-size: 1.05rem; }
  .buttons { display: flex; flex-wrap: wrap; gap: 0.75rem; }

  /* 2. Featured story + grid */
  .lead {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: 2.5rem;
    align-items: center;
    text-decoration: none;
    color: inherit;
    margin: 4rem 0 0;
  }
  .lead img { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; }
  .lead h2 { font-size: clamp(2rem, 3.4vw, 2.8rem); margin: 0.25rem 0 0.75rem; }
  .lead p { margin: 0; color: var(--ink-soft); }
  .lead .more { display: inline-block; margin-top: 1.25rem; color: var(--brass); font-weight: 600; }
  .lead:hover h2, .card:hover h3 { color: var(--brass); }

  .section-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem 2rem;
    margin: 4.5rem 0 1.75rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--rule);
  }
  .section-head h2 { margin: 0; font-size: 1.9rem; }
  .section-head p { margin: 0; color: var(--ink-soft); font-size: 0.95rem; }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3rem 2rem;
  }
  .card { display: block; text-decoration: none; color: inherit; }
  .frame { overflow: hidden; background: var(--paper-deep); }
  .frame img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; transition: transform 0.5s ease; }
  .card:hover .frame img { transform: scale(1.03); }
  /* Tall phone screenshots: three side by side instead of one cropped through the middle */
  .frame-set { display: flex; gap: 6px; aspect-ratio: 4 / 3; padding: 10px; background: #1c1a17; }
  .frame-grid { display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: minmax(0, 1fr) minmax(0, 1fr); gap: 4px; padding: 0; background: var(--paper-deep); }
  .frame-grid img { border-radius: 0 !important; object-position: center !important; width: 100%; height: 100%; min-height: 0; aspect-ratio: auto !important; }
  .frame-set img { flex: 1; min-width: 0; height: 100%; aspect-ratio: auto; object-fit: cover; object-position: top; border-radius: 6px; }
  .card-meta {
    margin: 1rem 0 0.25rem;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brass);
  }
  .card h3 { font-size: 1.35rem; margin: 0 0 0.4rem; transition: color 0.2s; }
  .card-desc {
    margin: 0;
    font-size: 0.95rem;
    color: var(--ink-soft);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* 3. Statement on its own tinted panel, after the work */
  .statement-panel { background: var(--paper-deep); margin-top: 5rem; padding: 4.5rem 0; }
  .statement { display: grid; grid-template-columns: 1fr 1.15fr; gap: 3.5rem; align-items: start; }
  .statement blockquote {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 2.8vw, 2.3rem);
    line-height: 1.25;
    font-style: italic;
    color: var(--ink);
    border-left: 3px solid var(--brass);
    padding-left: 1.5rem;
  }
  .statement-body p { margin: 0 0 1.1em; }

  /* 4. Contact on a dark panel */
  .contact-panel { background: var(--night); color: var(--paper); padding: 2.25rem 0; }
  .contact { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 0.5rem 2rem; }
  .contact p { margin: 0; color: #d6ccb6; }
  .contact a { color: var(--paper); }
  .contact a:hover { color: var(--brass-decorative, #c8a46a); }

  @media (max-width: 900px) {
    .mosaic { grid-template-columns: 1fr 1fr; grid-template-rows: 300px 170px 170px; }
    .t1 { grid-column: 1 / 3; grid-row: 1; }
    .t2 { grid-column: 1; grid-row: 2; }
    .t3 { grid-column: 2; grid-row: 2; }
    .t4 { grid-column: 1; grid-row: 3; }
    .t5 { grid-column: 2; grid-row: 3; }
    .hero-text, .lead, .statement { grid-template-columns: 1fr; gap: 1.5rem; }
    .grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .grid { grid-template-columns: 1fr; }
    .mosaic { grid-template-rows: 260px 140px 140px; }
  }
</style>
